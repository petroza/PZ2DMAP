function applyBasicProjectSnapshot(snapshot){
  const ranges = snapshot.ranges || {};
  const visibility = snapshot.visibility || {};
  applyColorSet(snapshot.colors || PRESETS.reset);
  ['majorWidth','minorWidth','buildingOpacity','boundaryOpacity','boundaryWidth'].forEach(id => {
    if($(id) && ranges[id] != null) $(id).value = String(ranges[id]);
  });
  ['showBuildings','showParks','showLandcover','showLanduse','showAeroway','showBoundaries','showLabels','showRoadShields','showMinorRoads','showMajorRoads'].forEach(id => {
    if($(id) && visibility[id] != null) $(id).checked = !!visibility[id];
  });

  const route = snapshot.route || {};
  state.pointA = route.pointA || null;
  state.pointB = route.pointB || null;
  state.clickPhase = route.clickPhase || (state.pointA && state.pointB ? 'done' : 'A');
  state.routeCoords = Array.isArray(route.routeCoords) ? route.routeCoords : [];
  state.manualViaPoints = Array.isArray(route.manualViaPoints) ? route.manualViaPoints : [];
  state.currentTransportMode = route.currentTransportMode || 'driving';
  if($('routeColor') && route.routeColor) $('routeColor').value = route.routeColor;
  if($('routeDotColor') && route.routeDotColor) $('routeDotColor').value = route.routeDotColor;
  if($('routeWidth') && route.routeWidth != null) $('routeWidth').value = String(route.routeWidth);
  setActiveButton('.transport-btn', 'mode', state.currentTransportMode);
  renderWaypointList();
  refreshManualViaMarkers();
  restorePointMarkers();
  redrawRoute();

  const animation = snapshot.animation || {};
  state.currentRotMode = animation.currentRotMode || 'fixed';
  setActiveButton('.rotation-mode-btn', 'rotmode', state.currentRotMode);
  ['animIconSize','animStart','animDuration','cameraPitch','animManualAngle'].forEach(id => {
    if($(id) && animation[id] != null) $(id).value = String(animation[id]);
  });
  if($('animManualAngleNumber') && animation.animManualAngle != null) $('animManualAngleNumber').value = String(Math.round(Number(animation.animManualAngle) || 0));
  ['invertIcons','animDot','showTrail','followCamera'].forEach(id => {
    if($(id) && animation[id] != null) $(id).checked = !!animation[id];
  });
  state.animSystemIcon = animation.animSystemIcon && ANIM_SYSTEM_ICONS[animation.animSystemIcon] ? animation.animSystemIcon : null;
  state.animIconData = state.animSystemIcon ? ANIM_SYSTEM_ICONS[state.animSystemIcon] : (animation.animIconData || null);
  renderAnimSystemIconSelection();
  renderAnimIconPreview();

  const cam = animation.camera || {};
  state.cameraAnim.enabled = !!cam.enabled;
  state.cameraAnim.mode = (cam.mode === 'zoom' || cam.mode === 'keyframes') ? cam.mode : 'flyTo';
  state.cameraAnim.start = cam.start || null;
  state.cameraAnim.end = cam.end || null;
  state.cameraAnim.keyframes = Array.isArray(cam.keyframes) ? cam.keyframes : [];
  if($('cameraAnimEnabled')) $('cameraAnimEnabled').checked = state.cameraAnim.enabled;
  setActiveButton('.camera-mode-btn', 'cammode', state.cameraAnim.mode);
  refreshCameraAnimInfo();
  renderCameraKeyframeList();
  updateCameraAnimUI();

  clearProjectSceneObjectsSilently();
  (snapshot.sceneIcons || []).forEach(item => createSceneIconAt(item.lngLat, {data:item.data, size:item.size, silent:true}));
  (snapshot.mapLabels || []).forEach(item => addMapLabelAt(item.lngLat, {text:item.text, size:item.size, side:item.side, silent:true}));
  if(state.mapLabels.length){
    const lastSize = state.mapLabels[state.mapLabels.length - 1].size || state.mapLabelGlobalSize || 28;
    applyMapLabelSizeToAll(lastSize);
  }

  applyOverlaySnapshot(snapshot.overlays || {});
  updateReadouts();
  applyMapTweaks();
  updateRouteStyle();

  if(snapshot.view && state.map){
    state.map.jumpTo({
      center: snapshot.view.center || [15.5,49.8],
      zoom: Number(snapshot.view.zoom || 7),
      pitch: Number(snapshot.view.pitch || 0),
      bearing: Number(snapshot.view.bearing || 0)
    });
  }
}

function applyProjectSnapshot(snapshot){
  const nextStyle = snapshot?.baseStyle || 'liberty';
  const doApply = () => {
    ensureOverlaySetup();
    window.setTimeout(() => {
      applyBasicProjectSnapshot(snapshot || {});
      setStatus('Projekt načten.');
    }, 120);
  };
  if(($('baseStyle')?.value || 'liberty') !== nextStyle){
    if($('baseStyle')) $('baseStyle').value = nextStyle;
    const once = () => {
      state.map.off('style.load', once);
      doApply();
    };
    state.map.on('style.load', once);
    reloadStyle();
    return;
  }
  doApply();
}

function saveCurrentProject(){
  const name = ($('projectName')?.value || '').trim() || ('Projekt ' + new Date().toLocaleString('cs-CZ'));
  const db = loadProjectDB().map(normalizeProjectEntry);
  const selectedId = getSelectedProjectId();
  const existingIdx = db.findIndex(item => item.id === selectedId || item.name === name);
  const base = existingIdx >= 0 ? db[existingIdx] : {id:'proj_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2,6), createdAt:Date.now()};
  const entry = {
    ...base,
    name,
    snapshot: serializeProjectSnapshot(),
    updatedAt: Date.now()
  };
  if(existingIdx >= 0) db[existingIdx] = entry;
  else db.push(entry);
  saveProjectDB(db);
  refreshProjectSelect();
  if($('savedProjectSelect')) $('savedProjectSelect').value = entry.id;
  setStatus('Projekt uložen.');
}

