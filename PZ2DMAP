function updateExportFrame(){
  const frame = $('exportFrame');
  const mapEl = $('map');
  if(!frame || !mapEl) return;
  const visible = $('showExportFrame')?.checked !== false;
  if(!visible){ frame.classList.add('hidden'); return; }
  const val = $('exportResolution')?.value || '1920x1080';
  const parts = val.split('x');
  const outW = Math.max(1, parseInt(parts[0] || '1920',10));
  const outH = Math.max(1, parseInt(parts[1] || '1080',10));
  const orient = outW > outH ? '⬌' : outW === outH ? '◻' : '⬍';
  frame.setAttribute('data-label', `${orient} ${outW}×${outH}`);
  const rect = mapEl.getBoundingClientRect();
  const aspect = outW / outH;
  let frameW, frameH;
  if(aspect >= 1){
    frameW = rect.width * 0.78;
    frameH = frameW / aspect;
    const maxH = rect.height * 0.72;
    if(frameH > maxH){ frameH = maxH; frameW = frameH * aspect; }
  } else {
    frameH = rect.height * 0.78;
    frameW = frameH * aspect;
    const maxW = rect.width * 0.72;
    if(frameW > maxW){ frameW = maxW; frameH = frameW / aspect; }
  }
  frame.style.width = Math.max(60, frameW) + 'px';
  frame.style.height = Math.max(60, frameH) + 'px';
  frame.classList.remove('hidden');
}

function getExportSize(){
  const val = $('exportResolution')?.value || '1920x1080';
  const [w,h] = val.split('x').map(v => Math.max(1, parseInt(v || '0', 10)));
  return {w: w || 1920, h: h || 1080};
}

function downloadBlob(filename, blob){
