/* ===== CAMERA ANIMATION (flyover / zoom) ===== */
function _lerp(a, b, t){ return a + (b - a) * t; }
function _lerpLng(a, b, t){ // shortest path across the antimeridian
  let d = b - a;
  if(d > 180) d -= 360; else if(d < -180) d += 360;
  return a + d * t;
}
function _lerpBearing(a, b, t){ let d = ((b - a) % 360 + 540) % 360 - 180; return a + d * t; }
function _easeInOutCubic(t){ return t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t + 2, 3) / 2; }
function captureCameraView(){
  if(!state.map) return null;
  return {
    center: state.map.getCenter().toArray(),
    zoom: state.map.getZoom(),
    pitch: state.map.getPitch(),
    bearing: state.map.getBearing()
  };
}
function cameraAnimReady(){
  if(!state.cameraAnim?.enabled || !state.map) return false;
  if(state.cameraAnim.mode === 'keyframes') return (state.cameraAnim.keyframes?.length || 0) >= 2;
  return !!(state.cameraAnim.start && state.cameraAnim.end);
}
function interpView(s, e, te){
  return {
    center: [_lerpLng(s.center[0], e.center[0], te), _lerp(s.center[1], e.center[1], te)],
    zoom: _lerp(s.zoom, e.zoom, te),
    pitch: _lerp(s.pitch, e.pitch, te),
    bearing: _lerpBearing(s.bearing, e.bearing, te)
  };
}
function getCameraStateAtProgress(t){
  const ca = state.cameraAnim;
  if(!ca) return null;
  const clamped = Math.max(0, Math.min(1, t));
  // Manual keyframe mode: interpolate between the surrounding keyframes (even-spaced by t).
  if(ca.mode === 'keyframes'){
    const kfs = (ca.keyframes || []).slice().sort((a, b) => a.t - b.t);
    if(!kfs.length) return null;
    if(kfs.length === 1 || clamped <= kfs[0].t) return interpView(kfs[0].view, kfs[0].view, 0);
    if(clamped >= kfs[kfs.length - 1].t) { const v = kfs[kfs.length - 1].view; return interpView(v, v, 0); }
    let a = kfs[0], b = kfs[kfs.length - 1];
    for(let i = 0; i < kfs.length - 1; i++){
      if(clamped >= kfs[i].t && clamped <= kfs[i + 1].t){ a = kfs[i]; b = kfs[i + 1]; break; }
    }
    const span = (b.t - a.t) || 1;
    return interpView(a.view, b.view, _easeInOutCubic((clamped - a.t) / span));
  }
  // Two-keyframe modes (flyover / zoom).
  if(!ca.start || !ca.end) return null;
  const s = ca.start, e = ca.end;
  const te = _easeInOutCubic(clamped);
  const view = interpView(s, e, te);
  if(ca.mode === 'flyTo'){
    // Cinematic "pull back then swoop in" — the dip grows with travel distance.
    const dx = e.center[0] - s.center[0], dy = e.center[1] - s.center[1];
    const dip = Math.min(3.2, Math.hypot(dx, dy) * 0.55);
    view.zoom -= dip * Math.sin(Math.PI * clamped);
  }
  return view;
}
function applyCameraAnimProgress(progress){
  if(!cameraAnimReady()) return false;
  const cam = getCameraStateAtProgress(progress);
  if(cam && state.map){
    state.map.jumpTo({ center: cam.center, zoom: cam.zoom, pitch: cam.pitch, bearing: cam.bearing });
    return true;
  }
  return false;
}
function refreshCameraAnimInfo(){
  const fmt = v => v ? `${v.center[1].toFixed(3)}, ${v.center[0].toFixed(3)} · z${v.zoom.toFixed(1)}` : '—';
  if($('cameraStartInfo')) $('cameraStartInfo').textContent = fmt(state.cameraAnim?.start);
  if($('cameraEndInfo')) $('cameraEndInfo').textContent = fmt(state.cameraAnim?.end);
}
function updateCameraAnimUI(){
  const en = !!$('cameraAnimEnabled')?.checked;
  if(state.cameraAnim) state.cameraAnim.enabled = en;
  const ctr = $('cameraAnimControls');
  if(ctr){ ctr.style.opacity = en ? '1' : '.5'; ctr.style.pointerEvents = en ? 'auto' : 'none'; }
  const isKf = state.cameraAnim?.mode === 'keyframes';
  const kfBox = $('cameraKeyframesBox'); if(kfBox) kfBox.style.display = isKf ? 'block' : 'none';
  const twoBox = $('cameraTwoPointBox'); if(twoBox) twoBox.style.display = isKf ? 'none' : 'block';
}
function redistributeKeyframeTimes(){
  const kfs = state.cameraAnim.keyframes;
  const n = kfs.length;
  kfs.forEach((kf, i) => { kf.t = n <= 1 ? 0 : i / (n - 1); });
}
function addCameraKeyframe(){
  const v = captureCameraView(); if(!v) return;
  state.cameraAnim.keyframes.push({ t: 0, view: v });
  redistributeKeyframeTimes();
  renderCameraKeyframeList();
  setStatus(t('Klíč kamery přidán ({0}).', state.cameraAnim.keyframes.length));
}
function removeCameraKeyframe(index){
  state.cameraAnim.keyframes.splice(index, 1);
