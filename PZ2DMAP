    row.innerHTML = `<span class="wp-badge">${idx+1}</span><div style="flex:1;min-width:0"><div style="font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escapeHtml(item.text || t('Popisek'))}</div><div class="small">${item.size}px · ${item.side === 'left' ? t('čtverec vlevo') : t('čtverec vpravo')}</div></div><button class="btn-remove" type="button" title="Smazat">×</button>`;
    row.addEventListener('click', ev => { if(ev.target.closest('.btn-remove')) return; selectMapLabel(item.id); });
    row.querySelector('.btn-remove').addEventListener('click', ev => { ev.stopPropagation(); deleteMapLabel(item.id); });
    list.appendChild(row);
  });
}

function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
}

function normalizeLngLatInput(lngLatObj){
  if(Array.isArray(lngLatObj)) return {lng: Number(lngLatObj[0]), lat: Number(lngLatObj[1])};
  return {lng: Number(lngLatObj?.lng), lat: Number(lngLatObj?.lat)};
}

function offsetLngLat(lngLatObj, offsetX=28, offsetY=24){
  const ll = normalizeLngLatInput(lngLatObj);
  if(!state.map || !Number.isFinite(ll.lng) || !Number.isFinite(ll.lat)) return [ll.lng || 0, ll.lat || 0];
  const px = state.map.project([ll.lng, ll.lat]);
  const shifted = state.map.unproject([px.x + offsetX, px.y + offsetY]);
  return [shifted.lng, shifted.lat];
}

function createSceneIconAt(lngLatObj, options={}){
