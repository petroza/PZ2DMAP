function applyPreferredMapLabelLanguage(){
  if(!state.map) return;
  // Cold loads over the network may not have the style ready within a fixed timeout,
  // which left the map showing default (English) labels until the user clicked a flag.
  // Re-apply as soon as the map is actually ready ('idle' implies the style is loaded).
  if(!state.map.isStyleLoaded()){
    if(!_labelLangPending){
      _labelLangPending = true;
      try{ state.map.once('idle', () => { _labelLangPending = false; applyPreferredMapLabelLanguage(); }); }
      catch(e){ _labelLangPending = false; }
