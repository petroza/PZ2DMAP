function initSectionAccordions(){
  $$('.sidebar .tab-pane .section').forEach((section, idx) => {
    if(section.dataset.accordionReady === '1') return;
    if(section.dataset.noCollapse === '1' || section.hasAttribute('data-no-collapse')) return;
    const h3 = section.querySelector(':scope > h3');
    if(!h3) return;

    const body = document.createElement('div');
    body.className = 'section-body';
    while(h3.nextSibling){
      body.appendChild(h3.nextSibling);
    }
    section.appendChild(body);
    section.classList.add('section-collapsible');

    const toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'section-toggle';
    toggle.setAttribute('aria-label', 'Rozbalit nebo sbalit sekci');
    toggle.innerHTML = '<span class="section-toggle-chevron"></span>';
    h3.appendChild(toggle);

    const storageKey = getAccordionStorageKey(section, idx);
    let open = isAccordionDefaultOpen(section, idx);
    try{
      const saved = localStorage.getItem(storageKey);
      if(saved === '0' || saved === '1') open = saved === '1';
    }catch(_){}
    setAccordionOpen(section, open, storageKey, false);

    const toggleSection = (ev) => {
      if(ev.target.closest('.badge')) return;
      ev.preventDefault();
      const nextOpen = section.classList.contains('collapsed');
      setAccordionOpen(section, nextOpen, storageKey, true);
    };

    h3.addEventListener('click', toggleSection);
    toggle.addEventListener('click', ev => { ev.stopPropagation(); toggleSection(ev); });
    section.dataset.accordionReady = '1';
  });
}

