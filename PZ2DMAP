  ['input','change'].forEach(evt => $('sceneIconSize')?.addEventListener(evt, ()=>{
    const item = getSceneIconById(state.selectedSceneIconId);
    if(item) updateSceneIcon(item.id, {size: $('sceneIconSize')?.value || item.size});
  }));
  $('addMapLabelBtn')?.addEventListener('click', ()=>{
    const next = !state.addingMapLabel;
    state.addingMapLabel = next;
    state.addingSceneIcon = false;
    state.addingFlightPoint = false;
    setStatus(next ? t('Režim popisků: klikáním do mapy vkládáš popisky. Dalším klikem na tlačítko režim vypneš.') : t('Režim popisků vypnut.'));
  });
  $('updateMapLabelBtn')?.addEventListener('click', applySelectedMapLabelChanges);
  $('deleteMapLabelBtn')?.addEventListener('click', ()=>{
    if(!state.selectedMapLabelId){ setStatus(t('Nejdřív vyber popisek.')); return; }
    deleteMapLabel(state.selectedMapLabelId);
  });
  $('clearMapLabelsBtn')?.addEventListener('click', clearMapLabels);
  document.addEventListener('click', e => {
    if(!e.target.closest('#presetContextMenu')) closePresetContextMenu();
    if(state.selectedSceneIconId){
      if(!e.target.closest('.scene-icon-marker') && !e.target.closest('.scene-icon-row') && !e.target.closest('#sceneIconUpload, #sceneIconSize, #addSceneIconBtn, #updateSceneIconBtn, #deleteSceneIconBtn, #clearSceneIconsBtn')){
        clearSceneIconSelection();
      }
    }
    if(!state.selectedMapLabelId) return;
    if(e.target.closest('.map-label-marker')) return;
    if(e.target.closest('.map-label-row')) return;
    if(e.target.closest('#mapLabelText, #mapLabelSize, #mapLabelSide, #addMapLabelBtn, #updateMapLabelBtn, #deleteMapLabelBtn, #clearMapLabelsBtn')) return;
    clearMapLabelSelection();
  });
  const ctxMenu = $('presetContextMenu');
  if(ctxMenu){
    ctxMenu.addEventListener('click', e => {
      const item = e.target.closest('.preset-context-item');
      if(!item) return;
      const action = item.dataset.action;
      const isBuiltin = ctxMenu.dataset.isBuiltin === '1';
      if(action === 'duplicate'){ duplicatePreset(ctxMenu.dataset.target, isBuiltin); }
      else if(action === 'rename'){ renamePresetFromContextMenu(); }
      else if(action === 'delete'){ deletePresetFromContextMenu(); }
      closePresetContextMenu();
      e.stopPropagation();
    });
  }
  $('mapLabelText')?.addEventListener('keydown', e => { if(e.key === 'Enter'){ e.preventDefault(); applySelectedMapLabelChanges(); } });
  $('mapLabelSize')?.addEventListener('input', ()=>{
    applyMapLabelSizeToAll($('mapLabelSize')?.value || state.mapLabelGlobalSize || 28);
  });
  $('mapLabelSide')?.addEventListener('change', ()=>{
    const item = getMapLabelById(state.selectedMapLabelId);
    if(item) updateMapLabel(item.id, {side: $('mapLabelSide')?.value || item.side});
  });
  $('savePresetBtn')?.addEventListener('click', dbSavePreset);
  $('loadPresetBtn')?.addEventListener('click', dbLoadPreset);
  $('updatePresetBtn')?.addEventListener('click', dbUpdatePreset);
  $('renamePresetBtn')?.addEventListener('click', dbRenamePreset);
  $('deletePresetBtn')?.addEventListener('click', dbDeletePreset);
  $('savedPresetSelect')?.addEventListener('change', ()=>{
    const id = $('savedPresetSelect').value;
    const {entry} = findCustomPresetById(id);
    if(entry && $('presetName')) $('presetName').value = entry.name;
  });
  // Tile source management
  $('addTileSourceBtn')?.addEventListener('click', addTileSource);
  $('addFlightWaypointBtn')?.addEventListener('click', ()=>{
    if(!state.pointA || !state.pointB){ setStatus(t('Nejdřív nastav body A a B, pak přidávej průjezdné body trasy.')); return; }
    state.addingFlightPoint = true; state.addingSceneIcon = false; state.addingMapLabel = false;
    setStatus(t('Klikni do mapy pro přidání bodu letu. Backspace vrací poslední bod, Ctrl + klik na bod ho smaže.'));
  });
  $('clearFlightWaypointsBtn')?.addEventListener('click', ()=>{ clearManualViaPoints(); if(state.pointA && state.pointB) findRoute(); setStatus(t('Body letu smazány.')); });

  $('countryBorderMode')?.addEventListener('change', applyPoliticalOverlayTweaks);
  $('countryFocusSelect')?.addEventListener('change', () => { syncCountrySelects($('countryFocusSelect')?.value || ''); applyPoliticalOverlayTweaks(); });
  $('politicalCountrySearch')?.addEventListener('input', () => { populateCountrySelects(); queueCountrySuggest(); });
  $('politicalCountrySearch')?.addEventListener('focus', queueCountrySuggest);
  $('politicalCountrySearch')?.addEventListener('blur', () => setTimeout(closeCountrySuggest, 160));
  $('politicalCountrySearch')?.addEventListener('keydown', e => {
    const box = $('politicalCountrySearchSuggest');
    const open = box?.dataset.open === '1';
    if(open && (e.key === 'ArrowDown' || e.key === 'ArrowUp')){
      e.preventDefault();
      moveCountrySuggest(e.key === 'ArrowDown' ? 1 : -1);
      return;
    }
    if(open && e.key === 'Escape'){
      closeCountrySuggest();
      return;
    }
    if(open && e.key === 'Enter'){
      const active = box.querySelector('.nav-suggest-item.active') || box.querySelector('.nav-suggest-item');
      if(active && active.dataset.idx != null){
        e.preventDefault();
        pickCountrySuggest(parseInt(active.dataset.idx, 10));
      }
    }
  });
  $('politicalCountrySelect')?.addEventListener('change', () => { syncCountrySelects($('politicalCountrySelect')?.value || ''); applyPoliticalOverlayTweaks(); });
  $('czRegionSearch')?.addEventListener('input', populateCzRegionSelect);
  $('czRegionSelect')?.addEventListener('change', applyPoliticalOverlayTweaks);
  $('paintPoliticalCountryOnClick')?.addEventListener('change', () => {
    syncPoliticalPaintModes('country');
    setStatus($('paintPoliticalCountryOnClick').checked ? 'Klikni do mapy na stát a obarví se.' : 'Barvení státu klikem vypnuto.');
  });
  $('paintCzRegionOnClick')?.addEventListener('change', () => {
    syncPoliticalPaintModes('region');
    setStatus($('paintCzRegionOnClick').checked ? 'Klikni do mapy na kraj a obarví se.' : 'Barvení kraje klikem vypnuto.');
  });
  $('applyPoliticalCountryColorBtn')?.addEventListener('click', applyPoliticalCountryColor);
  $('applyCzRegionColorBtn')?.addEventListener('click', applyCzRegionColor);
  $('resetPoliticalSelectionBtn')?.addEventListener('click', resetPoliticalSelection);
  $('clearPoliticalPaintingBtn')?.addEventListener('click', clearPoliticalPainting);
  $('zoomToCountryBtn')?.addEventListener('click', ()=> zoomToCountry($('politicalCountrySelect')?.value || $('countryFocusSelect')?.value));
  $('zoomToCzBtn')?.addEventListener('click', zoomToCzechia);
  if($('paintCzRegionOnClick')?.checked && $('paintPoliticalCountryOnClick')?.checked) syncPoliticalPaintModes('region');
  $('saveProjectBtn')?.addEventListener('click', saveCurrentProject);
  $('loadProjectBtn')?.addEventListener('click', loadSelectedProject);
  $('deleteProjectBtn')?.addEventListener('click', deleteSelectedProject);
  $('savedProjectSelect')?.addEventListener('change', ()=>{
    const entry = loadProjectDB().map(normalizeProjectEntry).find(item => item.id === getSelectedProjectId());
    if(entry && $('projectName')) $('projectName').value = entry.name;
  });

  renderPresetTiles();
  $$('.transport-btn').forEach(btn => btn.addEventListener('click', ()=>{
    state.currentTransportMode = btn.dataset.mode;
    state.addingFlightPoint = false;
    state.addingMapLabel = false;
    setActiveButton('.transport-btn', 'mode', state.currentTransportMode);
    state.smoothAngle = null;
    removeAnimMarker();
    renderAnimIconPreview();
    updateRouteStyle();
    if(state.pointA && state.pointB && state.routeCoords.length) findRoute();
    else if(!state.animPlaying && state.routeCoords.length && $('animDot')?.checked){
      const delay = parseFloat($('animStart')?.value || '0');
      const dur = Math.max(0.001, parseFloat($('animDuration')?.value || '8'));
      const progress = state.animElapsed <= delay ? 0 : Math.min(1, (state.animElapsed - delay) / dur);
      setAnimProgress(progress);
    }
  }));
  $$('.rotation-mode-btn').forEach(btn => btn.addEventListener('click', ()=>{ state.currentRotMode = btn.dataset.rotmode; setActiveButton('.rotation-mode-btn', 'rotmode', state.currentRotMode); state.smoothAngle = null; }));
  refreshPresetSelect();
  renderPresetTiles();
  renderAnimSystemIconSelection();
  renderAnimIconPreview();
  initAngleDial();
  syncAnimAngleInputs('range');
  setActiveButton('.transport-btn', 'mode', state.currentTransportMode);
  setActiveButton('.rotation-mode-btn', 'rotmode', state.currentRotMode);
}


