/* ===== AFTER EFFECTS EXPORT (.jsx) ===== */
// Project a geographic point to a pixel position inside the EXPORTED video frame
// (the map is cropped to the export frame and scaled to the output resolution).
function _aeExportFrameRects(){
  const mapCanvas = state.map?.getCanvas?.(); if(!mapCanvas) return null;
  const mapRect = mapCanvas.getBoundingClientRect();
  let frameRect = mapRect;
  const frame = $('exportFrame');
  if($('showExportFrame')?.checked && frame && !frame.classList.contains('hidden')) frameRect = frame.getBoundingClientRect();
  return { mapRect, frameRect };
}
function _aeProject(lngLat, rects, outW, outH){
  if(!lngLat || !state.map || !rects) return null;
  const lp = state.map.project(lngLat);
  const { mapRect, frameRect } = rects;
  if(!frameRect.width || !frameRect.height) return null;
  const relX = lp.x - (frameRect.left - mapRect.left);
  const relY = lp.y - (frameRect.top - mapRect.top);
  return [ relX / frameRect.width * outW, relY / frameRect.height * outH ];
}
async function collectAeTrackingData(){
  if(!state.map) return null;
  const fps = Math.max(1, Number($('exportFps')?.value || '25'));
  const total = animationTotal();
  const { w: outW, h: outH } = getExportSize();
  const frames = Math.max(1, Math.round(total * fps));
  const delay = parseFloat($('animStart')?.value || '0');
  const dur = Math.max(0.001, parseFloat($('animDuration')?.value || '8'));
  const hasRoute = state.routeCoords.length > 1;
  const icons = state.sceneIcons.map(it => ({
    name: it.id,
    lngLat: it.marker?.getLngLat ? [it.marker.getLngLat().lng, it.marker.getLngLat().lat] : it.lngLat,
    kf: []
  })).filter(s => Array.isArray(s.lngLat) && s.lngLat.length === 2);
  const car = [];
  const oldElapsed = state.animElapsed, oldPlaying = state.animPlaying;
  stopAnimation();
  setStatus(t('Připravuji data pro After Effects…'));
  let ppm0 = null;
  for(let i = 0; i < frames; i++){
    const elapsed = Math.min(total, i / fps);
    state.animElapsed = elapsed;
    const progress = elapsed <= delay ? 0 : Math.min(1, (elapsed - delay) / dur);
    setAnimProgress(progress);
    await waitMapRender();
    const rects = _aeExportFrameRects();
    if(!rects) continue;
    const tSec = +(i / fps).toFixed(4);
    if(hasRoute){
      const pt = sliceLineByProgress(state.routeCoords, progress).point;
      const ahead = sliceLineByProgress(state.routeCoords, Math.min(1, progress + 0.01)).point;
      const p = _aeProject(pt, rects, outW, outH);
      if(p){
        const pa = ahead ? _aeProject(ahead, rects, outW, outH) : null;
        const dLat = 50 / 111320; // 50 m north, for scale reference
        const pNorth = _aeProject([pt[0], pt[1] + dLat], rects, outW, outH);
        let scale = 100;
        if(pNorth){ const ppm = Math.hypot(pNorth[0] - p[0], pNorth[1] - p[1]) / 50; if(ppm0 === null && ppm > 0) ppm0 = ppm; if(ppm0) scale = ppm / ppm0 * 100; }
        let rot = 0;
        if(pa){ const dx = pa[0] - p[0], dy = pa[1] - p[1]; if(Math.hypot(dx, dy) > 1e-4) rot = Math.atan2(dx, -dy) * 180 / Math.PI; }
        car.push({ t: tSec, x: +p[0].toFixed(2), y: +p[1].toFixed(2), r: +rot.toFixed(2), s: +scale.toFixed(2) });
      }
    }
    icons.forEach(s => { const p = _aeProject(s.lngLat, rects, outW, outH); if(p) s.kf.push({ t: tSec, x: +p[0].toFixed(2), y: +p[1].toFixed(2) }); });
  }
  restoreAnimationState(oldElapsed, oldPlaying);
  // Unwrap rotation so AE doesn't spin the object across the ±180° seam.
  for(let i = 1; i < car.length; i++){
    while(car[i].r - car[i - 1].r > 180) car[i].r -= 360;
    while(car[i].r - car[i - 1].r < -180) car[i].r += 360;
  }
  return { w: outW, h: outH, fps, dur: +total.toFixed(3), hasRoute: hasRoute && car.length > 0, car, icons };
}
function _aeArr(nums){ return '[' + nums.join(',') + ']'; }
function buildAeJsx(data, opts){
  const compName = (opts.compName || 'PZ MAP').replace(/["\\]/g, ' ').slice(0, 60);
  const cand = (opts.videoCandidates || []).map(c => '"' + c.replace(/["\\]/g, '') + '"').join(',');
  const L = [];
  L.push('// PZ MAP -> After Effects   (auto-generated)');
  L.push('// Spuštění: File > Scripts > Run Script File...  Video nech ve stejné složce jako tento .jsx.');
  L.push('(function(){');
  L.push('  var W=' + data.w + ', H=' + data.h + ', FR=' + data.fps + ', DUR=' + data.dur + ';');
  L.push('  if (typeof app === "undefined") { return; }');
  L.push('  if (!app.project) { try { app.newProject(); } catch(e){} }');
  L.push('  app.beginUndoGroup("PZ MAP import");');
  L.push('  var comp = app.project.items.addComp("' + compName + '", W, H, 1.0, DUR, FR);');
  L.push('  comp.openInViewer();');
  L.push('  // ---- video ----');
  L.push('  var added=false, folder=null;');
  L.push('  try { folder = File($.fileName).parent; } catch(e){}');
  L.push('  var candidates=[' + cand + '];');
  L.push('  if (folder){ for (var c=0;c<candidates.length;c++){ var f=new File(folder.fsName+"/"+candidates[c]); if (f.exists){ try{ var foot=app.project.importFile(new ImportOptions(f)); var vl=comp.layers.add(foot); vl.name="MAP VIDEO"; vl.moveToEnd(); added=true; break; }catch(e){} } } }');
  L.push('  if(!added){');
  L.push('    // Video se nenašlo automaticky — necháme uživatele vybrat soubor ručně.');
  L.push('    var picked = File.openDialog("Vyber vyrenderované video z mapy (" + candidates[0] + ")");');
  L.push('    if (picked){ try{ var foot2=app.project.importFile(new ImportOptions(picked)); var vl2=comp.layers.add(foot2); vl2.name="MAP VIDEO"; vl2.moveToEnd(); added=true; }catch(e){} }');
  L.push('  }');
  L.push('  if(!added){ var ph=comp.layers.addSolid([0.08,0.08,0.09],"MAP VIDEO (nahraď svým videem)",W,H,1.0); ph.moveToEnd(); }');
  L.push('  // ---- volitelná 3D kamera ----');
  L.push('  var cam=comp.layers.addCamera("MAP_CAM",[W/2,H/2]);');
  L.push('  function P(l){return l.property("ADBE Transform Group").property("ADBE Position");}');
  L.push('  function RZ(l){return l.property("ADBE Transform Group").property("ADBE Rotate Z");}');
  L.push('  function SC(l){return l.property("ADBE Transform Group").property("ADBE Scale");}');
  L.push('  function mkNull(nm){var n=comp.layers.addNull(); n.name=nm; return n;}');
  if(data.hasRoute){
    L.push('  // ---- trackovací NULL pro objekt na trase (napoj sem svůj 3D objekt) ----');
    L.push('  var T=' + _aeArr(data.car.map(k => k.t)) + ';');
    L.push('  var X=' + _aeArr(data.car.map(k => k.x)) + ';');
    L.push('  var Y=' + _aeArr(data.car.map(k => k.y)) + ';');
    L.push('  var RO=' + _aeArr(data.car.map(k => k.r)) + ';');
    L.push('  var S=' + _aeArr(data.car.map(k => k.s)) + ';');
    L.push('  var car=mkNull("MAP_TRACK_CAR");');
    L.push('  var cp=P(car), cr=RZ(car), cs=SC(car);');
    L.push('  for (var i=0;i<T.length;i++){ cp.setValueAtTime(T[i],[X[i],Y[i]]); cr.setValueAtTime(T[i],RO[i]); cs.setValueAtTime(T[i],[S[i],S[i]]); }');
  }
  (data.icons || []).forEach((ic, idx) => {
    if(!ic.kf || !ic.kf.length) return;
    L.push('  // ---- trackovací NULL pro objekt na mapě #' + (idx + 1) + ' ----');
    L.push('  var iT' + idx + '=' + _aeArr(ic.kf.map(k => k.t)) + ';');
    L.push('  var iX' + idx + '=' + _aeArr(ic.kf.map(k => k.x)) + ';');
    L.push('  var iY' + idx + '=' + _aeArr(ic.kf.map(k => k.y)) + ';');
    L.push('  var nul' + idx + '=mkNull("MAP_TRACK_' + (idx + 1) + '");');
    L.push('  var np' + idx + '=P(nul' + idx + ');');
    L.push('  for (var j=0;j<iT' + idx + '.length;j++){ np' + idx + '.setValueAtTime(iT' + idx + '[j],[iX' + idx + '[j],iY' + idx + '[j]]); }');
  });
  L.push('  app.endUndoGroup();');
  L.push('  try{ alert("PZ MAP: kompozice je hotová.\\nNa NULL \'MAP_TRACK_CAR\' napoj (parent) svůj 3D objekt — pojede po trase."); }catch(e){}');
  L.push('})();');
  L.push('');
  return L.join('\n');
}
async function exportAeScript(opts){
  opts = opts || {};
  if(!state.map){ setStatus(t('AE export se nezdařil.')); return false; }
  if(!(state.routeCoords.length > 1) && !state.sceneIcons.length && !cameraAnimReady()){
    setStatus(t('Pro AE export nastav trasu, ikonu na mapě nebo kameru.')); return false;
  }
  const data = await collectAeTrackingData();
  if(!data){ setStatus(t('AE export se nezdařil.')); return false; }
  const presetName = $('presetName')?.value || 'map-video';
  const base = slugifyName(presetName);
  const fmt = $('exportVideoFormat')?.value || 'mp4';
  // Candidate filenames the AE script will look for next to itself, most-likely first.
  const cand = [];
  if(opts.videoFile) cand.push(opts.videoFile); // the exact file we just produced
  const byFmt = fmt === 'webm' ? ['.webm', '.mp4', '.mov'] : ['.mp4', '.webm', '.mov'];
  byFmt.forEach(ext => { const n = base + ext; if(!cand.includes(n)) cand.push(n); });
  const jsx = buildAeJsx(data, { compName: presetName, videoCandidates: cand });
  downloadBlob(base + '_AE.jsx', new Blob([jsx], { type: 'application/javascript' }));
  const n = data.car.length || (data.icons[0]?.kf.length || 0);
  setStatus(t('AE skript stažen ({0} snímků).', n));
  return true;
}

async function exportPngSequence(){
  if(!state.routeCoords.length && !cameraAnimReady()){ setStatus(t('Nejdřív najdi trasu nebo nastav kameru.')); return; }
  if(typeof JSZip === 'undefined'){ setStatus(t('Nepodařilo se načíst JSZip.')); return; }
  const fps = Number($('exportFps')?.value || '25');
  const total = animationTotal();
  const frames = Math.max(1, Math.round(total * fps));
  const canvas = document.createElement('canvas');
  if(!(await drawCurrentMapFrame(canvas))){ setStatus(t('Nepovedlo se připravit exportní canvas.')); return; }
  const zip = new JSZip();
  const oldElapsed = state.animElapsed;
  const oldPlaying = state.animPlaying;
  stopAnimation();
  setStatus(t('Exportuji PNG sekvenci…'));
  for(let i=0;i<frames;i++){
    const elapsed = i / fps;
    state.animElapsed = Math.min(total, elapsed);
    const delay = parseFloat($('animStart')?.value || '0');
    const dur = Math.max(0.001, parseFloat($('animDuration')?.value || '8'));
    const progress = elapsed <= delay ? 0 : Math.min(1, (elapsed - delay) / dur);
    setAnimProgress(progress);
    await waitMapRender();
    await drawCurrentMapFrame(canvas);
    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
    zip.file('frame_' + String(i).padStart(5,'0') + '.png', blob);
  }
  const blob = await zip.generateAsync({ type: 'blob' });
  restoreAnimationState(oldElapsed, oldPlaying);
  downloadBlob(slugifyName(($('presetName')?.value || 'map-sequence')) + '-png-sequence.zip', blob);
  setStatus(t('PNG sekvence ZIP stažena.'));
}

