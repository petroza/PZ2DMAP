  }
  kfs.forEach((kf, i) => {
    const row = document.createElement('div');
    row.className = 'camera-kf-row';
    const label = document.createElement('span');
    label.className = 'small';
    label.textContent = `#${i + 1} · z${kf.view.zoom.toFixed(1)} · ${kf.view.pitch.toFixed(0)}° · ${Math.round(kf.t * 100)}%`;
    const preview = document.createElement('button');
    preview.type = 'button'; preview.className = 'btn btn-sm'; preview.textContent = '👁';
    preview.title = t('Náhled');
    preview.addEventListener('click', () => { if(state.map) state.map.flyTo({ ...kf.view, duration: 700 }); });
    const del = document.createElement('button');
    del.type = 'button'; del.className = 'btn btn-sm btn-danger'; del.textContent = '×';
    del.title = t('Smazat');
    del.addEventListener('click', () => removeCameraKeyframe(i));
    row.appendChild(label); row.appendChild(preview); row.appendChild(del);
    list.appendChild(row);
