function getFitPadding(){
  const base = 44;
  const mapEl = $('map');
  if(!state.map || !mapEl) return {top:base,right:base,bottom:base,left:base};
  const mapRect = mapEl.getBoundingClientRect();
  const frameVisible = $('showExportFrame')?.checked && $('exportFrame') && !$('exportFrame').classList.contains('hidden');
  if(!frameVisible) return {top:base,right:base,bottom:base,left:base};
  const frameRect = $('exportFrame').getBoundingClientRect();
  return {
    top: Math.max(base, Math.round(frameRect.top - mapRect.top) + 36),
    right: Math.max(base, Math.round(mapRect.right - frameRect.right) + 36),
    bottom: Math.max(base, Math.round(mapRect.bottom - frameRect.bottom) + 36),
    left: Math.max(base, Math.round(frameRect.left - mapRect.left) + 36)
  };
}

function fitRoute(){
  if(!state.routeCoords.length) return;
  const bounds = state.routeCoords.reduce((b,c)=>b.extend(c), new maplibregl.LngLatBounds(state.routeCoords[0], state.routeCoords[0]));
  state.map.fitBounds(bounds, {padding:getFitPadding(), duration:800});
