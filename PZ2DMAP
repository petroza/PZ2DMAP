const _countrySuggestState = { debounce: null, items: [], activeIdx: -1 };

function getCountrySearchItems(query=''){
  const list = (state.countriesGeojson?.features || [])
    .map(f => ({id:f.properties.__appId, name:f.properties.__appName, iso:f.properties.__appIso || ''}))
    .filter(item => item.id && item.name)
    .sort((a,b)=> String(a.name).localeCompare(String(b.name), 'cs'));
  const q = String(query || '').trim();
  if(!q) return [];
  return list.filter(item => matchesNormalizedSearch(item.name + ' ' + item.iso, q)).slice(0, 12);
