function normalizeLoose(value){
  return String(value || '')
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

function getFeatureApproxCenter(feature){
  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  let found = false;
  (function walk(coords){
    if(!Array.isArray(coords)) return;
    if(typeof coords[0] === 'number' && typeof coords[1] === 'number'){
      const x = Number(coords[0]);
      const y = Number(coords[1]);
      if(Number.isFinite(x) && Number.isFinite(y)){
        minX = Math.min(minX, x);
        minY = Math.min(minY, y);
        maxX = Math.max(maxX, x);
        maxY = Math.max(maxY, y);
        found = true;
      }
      return;
    }
    coords.forEach(walk);
  })(feature?.geometry?.coordinates);
  return found ? [(minX + maxX) / 2, (minY + maxY) / 2] : null;
}

function findNearestCzRegionByCenter(center){
  if(!Array.isArray(center) || center.length < 2) return null;
  let best = null;
  let bestDist = Infinity;
  CZ_REGION_REFERENCE.forEach(item => {
    const dx = center[0] - item.center[0];
    const dy = center[1] - item.center[1];
    const dist = dx * dx + dy * dy;
    if(dist < bestDist){
      bestDist = dist;
      best = item;
    }
  });
  return best;
}

function resolveCzRegionMeta(feature, idx){
  const props = feature?.properties || {};
  // Try all known name fields (Czech and English GeoJSON sources)
  const rawName = firstDefined(props, ['VUSC_NAZEV','name','Name','NAME_1','nazev','region','NAME','KRAJ','Region','RegionName']) || '';
  const normName = normalizeLoose(rawName);

  // 1. Exact alias match
  let matched = CZ_REGION_REFERENCE_BY_NORM[normName] || null;

  // 2. NUTS code match (e.g. CZ010 = Praha, CZ020 = Středočeský)
  if(!matched){
    const nuts = firstDefined(props, ['NUTS_ID','NUTS3_CODE','nuts_id','nuts3','KOD_NUTS3','KOD_CZNUTS3']) || '';
    const nutsMap = {
      'CZ010':'HLAVNI-MESTO-PRAHA','CZ020':'STREDOCESKY-KRAJ','CZ031':'JIHOCESKY-KRAJ',
      'CZ032':'PLZENSKY-KRAJ','CZ041':'KARLOVARSKY-KRAJ','CZ042':'USTECKY-KRAJ',
      'CZ051':'LIBERECKY-KRAJ','CZ052':'KRALOVEHRADECKY-KRAJ','CZ053':'PARDUBICKY-KRAJ',
      'CZ063':'KRAJ-VYSOCINA','CZ064':'JIHOMORAVSKY-KRAJ','CZ071':'OLOMOUCKY-KRAJ',
      'CZ072':'ZLINSKY-KRAJ','CZ080':'MORAVSKOSLEZSKY-KRAJ'
    };
    if(nutsMap[nuts.toUpperCase()]) matched = CZ_REGION_REFERENCE.find(r => r.id === nutsMap[nuts.toUpperCase()]) || null;
  }

  // 3. Partial name overlap
  if(!matched && normName){
    matched = CZ_REGION_REFERENCE.find(item => {
      const base = normalizeLoose(item.name);
      return base === normName || base.includes(normName) || normName.includes(base);
    }) || null;
  }

  // 4. Alias substring match (handles "Hl. m. Praha", "HMP" etc.)
  if(!matched && normName){
    matched = CZ_REGION_REFERENCE.find(item =>
      (item.aliases || []).some(a => normalizeLoose(a) === normName || normName.startsWith(normalizeLoose(a)))
    ) || null;
  }

  // 5. Last resort: nearest region by geographic center
  if(!matched || /^kraj\s*\d+$/i.test(rawName)){
    matched = findNearestCzRegionByCenter(getFeatureApproxCenter(feature));
  }

  if(matched) return {id: matched.id, name: matched.name};
  const fallbackName = rawName || ('Kraj ' + (idx + 1));
  return {id: slugifyName(fallbackName).toUpperCase(), name: fallbackName};
}

