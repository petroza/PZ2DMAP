function deleteSelectedPresetTiles(){
  if(!(state.selectedPresetTokens instanceof Set)) state.selectedPresetTokens = new Set();
  const tokens = Array.from(state.selectedPresetTokens).filter(Boolean);
  if(!tokens.length) return false;

  let hidden = loadHiddenBuiltinPresets();
  let db = loadPresetDB();
  const customIdsToDelete = new Set();
  let deleted = 0;

  tokens.forEach(token => {
    if(token.startsWith('builtin:')){
      const key = token.slice(8);
      if(PRESETS[key] && !hidden.includes(key)){
        hidden.push(key);
        deleted++;
      }
      if(state.activePresetToken === token) state.activePresetToken = null;
    }else if(token.startsWith('custom:')){
      const id = token.slice(7);
      if(db.some(item => item.id === id)){
        customIdsToDelete.add(id);
        deleted++;
      }
      if(state.activePresetToken === token) state.activePresetToken = null;
    }
  });

  if(!deleted){
    state.selectedPresetTokens.clear();
    updatePresetTileActiveState();
    return false;
  }

  if(customIdsToDelete.size){
    db = db.filter(item => !customIdsToDelete.has(item.id));
    savePresetDB(db);
  }
  saveHiddenBuiltinPresets(hidden);
  refreshPresetSelect();
  syncPresetSelection('');
  state.selectedPresetTokens.clear();
  closePresetContextMenu();
  renderPresetTiles();
  setStatus(deleted === 1 ? 'Preset smazán.' : ('Smazáno presetů: ' + deleted + '.'));
  return true;
}
