}

function getExportCrop(){
  if(state.exportCropOverride && typeof state.exportCropOverride === 'function'){
    try{
      const overrideCrop = state.exportCropOverride();
      if(overrideCrop) return overrideCrop;
    }catch(e){ console.warn('Export crop override failed', e); }
  }
  if(!state.map) return null;
  const mapCanvas = state.map.getCanvas();
  if(!mapCanvas) return null;
  const mapRect = mapCanvas.getBoundingClientRect();
  let frameRect = mapRect;
  const frame = $('exportFrame');
  if($('showExportFrame')?.checked && frame && !frame.classList.contains('hidden')) frameRect = frame.getBoundingClientRect();
  const sx = mapCanvas.width / Math.max(1, mapRect.width);
  const sy = mapCanvas.height / Math.max(1, mapRect.height);
  const {w:outW, h:outH} = getExportSize();
  return {
    source: mapCanvas,
    x: Math.max(0, (frameRect.left - mapRect.left) * sx),
    y: Math.max(0, (frameRect.top - mapRect.top) * sy),
    w: Math.max(2, Math.min(mapCanvas.width, frameRect.width * sx)),
    h: Math.max(2, Math.min(mapCanvas.height, frameRect.height * sy)),
    outW, outH
  };
}


function cloneExportStyle(){
  // Export must start from the *current live map style*, not from the original preset.
  // Otherwise runtime layer visibility is lost in PNG/video export — especially road shields
  // (the small rectangles with road numbers) that the user may have switched off.
  try{
    const liveStyle = state.map?.getStyle?.();
    if(liveStyle?.version && liveStyle?.sources && Array.isArray(liveStyle.layers)){
      return JSON.parse(JSON.stringify(liveStyle));
    }
  }catch(e){
    console.warn('Could not clone live map style for export, falling back to preset style.', e);
  }
  const styleKey = $('baseStyle')?.value || 'liberty';
  const style = getAllStyles()[styleKey] || STYLES.liberty;
  if(typeof style === 'string') return style;
  try{ return JSON.parse(JSON.stringify(style)); }catch(e){ return style; }
}

function waitForMapEventOnce(map, eventName, timeoutMs=1200){
  return new Promise(resolve => {
    let done = false;
    const finish = () => {
      if(done) return;
      done = true;
      try{ map.off(eventName, finish); }catch(e){}
      resolve();
    };
    try{ map.once(eventName, finish); }catch(e){ resolve(); return; }
    setTimeout(finish, timeoutMs);
  });
}

function getExportDetailWaitMs(){
  const {w,h} = getExportSize();
  const megaPixels = (w * h) / 1000000;
  // 4K/8K needs time for native high-zoom vector/raster tiles. If captured too early,
  // MapLibre uses low-detail parent tiles and the result looks like an upscaled browser screenshot.
  return Math.round(Math.max(6500, Math.min(32000, 4200 + megaPixels * 760)));
}

function waitForExportTilesLoaded(map, timeoutMs){
  return new Promise(resolve => {
    const start = performance.now();
    let stableFrames = 0;
    const check = () => {
      let styleLoaded = true;
      let tilesLoaded = true;
      try{ styleLoaded = typeof map.isStyleLoaded === 'function' ? map.isStyleLoaded() : true; }catch(e){ styleLoaded = true; }
      try{ tilesLoaded = typeof map.areTilesLoaded === 'function' ? map.areTilesLoaded() : true; }catch(e){ tilesLoaded = true; }
      if(styleLoaded && tilesLoaded) stableFrames += 1;
      else stableFrames = 0;
      if(stableFrames >= 4 || performance.now() - start > timeoutMs){
        requestAnimationFrame(() => requestAnimationFrame(resolve));
        return;
      }
      try{ map.triggerRepaint(); }catch(e){}
      setTimeout(() => requestAnimationFrame(check), 120);
    };
    check();
  });
}

async function waitExportMapReady(map, timeoutMs=getExportDetailWaitMs()){
  if(!map) return;
  if(!map.isStyleLoaded?.()) await waitForMapEventOnce(map, 'load', Math.min(timeoutMs, 9000));
  try{ map.resize(); map.triggerRepaint(); }catch(e){}
  await waitForExportTilesLoaded(map, timeoutMs);
  await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
}

function getHiddenStyleLayerIds(map=state.map){
  try{
    const style = map?.getStyle?.();
    if(!style?.layers) return [];
    return style.layers
      .filter(layer => {
        try{ return map.getLayoutProperty(layer.id, 'visibility') === 'none' || layer.layout?.visibility === 'none'; }
        catch(e){ return layer.layout?.visibility === 'none'; }
      })
      .map(layer => layer.id)
      .filter(Boolean);
  }catch(e){ return []; }
}

function applyHiddenStyleLayerIds(layerIds){
  if(!Array.isArray(layerIds) || !layerIds.length) return;
  layerIds.forEach(id => safeSetLayout(id, 'visibility', 'none'));
}

function getLiveSourceDataFromMap(map, sourceId){
  try{
    const src = map?.getSource?.(sourceId);
    const data = src?._data || src?._options?.data || src?.serialize?.()?.data || null;
    if(!data) return null;
    return typeof data === 'string' ? data : JSON.parse(JSON.stringify(data));
  }catch(e){ return null; }
}

function applyCapturedRouteSources(ghostData, animData){
  try{
    ensureRouteSources();
    if(ghostData) state.map.getSource('route-ghost')?.setData(ghostData);
    if(animData) state.map.getSource('route-anim')?.setData(animData);
