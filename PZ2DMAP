function getExportVideoBitrate(base=16000000){
  const {w,h} = getExportSize();
  const scale = Math.max(1, (w * h) / (1920 * 1080));
  return Math.round(base * Math.min(16, scale));
}

function buildMp4MimeCandidates(){
  return [
    'video/mp4;codecs="avc1.424028"',
    'video/mp4;codecs="avc1.42E01E"',
    'video/mp4;codecs=avc1',
    'video/mp4'
  ];
}

function buildWebmMimeCandidates(){
  return [
    'video/webm;codecs=vp9',
    'video/webm;codecs=vp8',
    'video/webm'
  ];
}

function getSupportedRecorderType(candidates){
  if(typeof MediaRecorder === 'undefined') return null;
  return candidates.find(type => MediaRecorder.isTypeSupported ? MediaRecorder.isTypeSupported(type) : type === 'video/webm') || null;
}

async function exportRecordedVideo({ mimeCandidates, extension, startStatusKey, doneStatusKey, unsupportedStatusKey, bitsPerSecond = getExportVideoBitrate(12000000) }){
  if(!state.routeCoords.length && !cameraAnimReady()){ setStatus(t('Nejdřív najdi trasu nebo nastav kameru.')); return false; }
  if(typeof MediaRecorder === 'undefined'){ setStatus(t('Tvůj prohlížeč neumí MediaRecorder.')); return false; }
  const fps = Math.max(1, Number($('exportFps')?.value || '25'));
  const total = animationTotal();
  const canvas = document.createElement('canvas');
  if(!(await drawCurrentMapFrame(canvas))){ setStatus(t('Nepovedlo se připravit exportní canvas.')); return false; }
  const supported = getSupportedRecorderType(mimeCandidates);
  if(!supported){
    if(unsupportedStatusKey) setStatus(t(unsupportedStatusKey));
    return false;
  }
  const manualTrackFps = typeof canvas.captureStream === 'function' ? 0 : fps;
  const stream = canvas.captureStream(manualTrackFps);
  const videoTrack = stream.getVideoTracks ? stream.getVideoTracks()[0] : null;
  const canRequestFrame = !!(videoTrack && typeof videoTrack.requestFrame === 'function');
  const chunks = [];
  const recorder = new MediaRecorder(stream, { mimeType: supported, videoBitsPerSecond: bitsPerSecond });
  recorder.ondataavailable = e => { if(e.data && e.data.size) chunks.push(e.data); };
  const stopped = new Promise(resolve => recorder.onstop = resolve);
  const oldElapsed = state.animElapsed;
  const oldPlaying = state.animPlaying;
  stopAnimation();
  recorder.start();
  setStatus(t(startStatusKey));
  const frames = Math.max(1, Math.round(total * fps));
  const frameStepMs = 1000 / fps;
  const delay = parseFloat($('animStart')?.value || '0');
  const dur = Math.max(0.001, parseFloat($('animDuration')?.value || '8'));
  const exportStartTs = performance.now();
  for(let i=0;i<frames;i++){
    const elapsed = Math.min(total, i / fps);
    state.animElapsed = elapsed;
    const progress = elapsed <= delay ? 0 : Math.min(1, (elapsed - delay) / dur);
    setAnimProgress(progress);
    await waitMapRender(Math.min(64, Math.max(16, Math.round(frameStepMs * 0.9))));
    await drawCurrentMapFrame(canvas);
    if(canRequestFrame){
      try{ videoTrack.requestFrame(); }catch(e){}
    }
    const nextFrameTs = exportStartTs + ((i + 1) * frameStepMs);
    const remaining = nextFrameTs - performance.now();
    if(i < frames && remaining > 1){
      await wait(remaining);
    }
  }
  recorder.stop();
  await stopped;
  if(videoTrack && typeof videoTrack.stop === 'function'){
    try{ videoTrack.stop(); }catch(e){}
  }
  restoreAnimationState(oldElapsed, oldPlaying);
  const blob = new Blob(chunks, { type: supported });
  const fname = videoExportName(extension);
  downloadBlob(fname, blob);
  setStatus(t(doneStatusKey));
  return fname;
}
function videoExportName(ext){ return slugifyName(($('presetName')?.value || 'map-video')) + ext; }

async function exportWebM(){
  return exportRecordedVideo({
    mimeCandidates: buildWebmMimeCandidates(),
    extension: '.webm',
    startStatusKey: 'Exportuji WebM…',
    doneStatusKey: 'WebM video staženo.',
    unsupportedStatusKey: 'WebM export není v tomto prohlížeči dostupný.'
  });
}

async function exportMp4H264Exact(){
  if(!state.routeCoords.length && !cameraAnimReady()){ setStatus(t('Nejdřív najdi trasu nebo nastav kameru.')); return false; }
  if(typeof VideoEncoder === 'undefined' || typeof VideoFrame === 'undefined') return false;
  let muxerLib = null;
  try{
    muxerLib = await import('https://cdn.jsdelivr.net/npm/mp4-muxer@5.1.0/+esm');
  }catch(err){
    console.warn('mp4-muxer import failed', err);
    return false;
  }
  const { Muxer, ArrayBufferTarget } = muxerLib || {};
  if(!Muxer || !ArrayBufferTarget) return false;

  const fps = Math.max(1, Number($('exportFps')?.value || '25'));
  const total = animationTotal();
  const frames = Math.max(1, Math.round(total * fps));
  const canvas = document.createElement('canvas');
  if(!(await drawCurrentMapFrame(canvas))){ setStatus(t('Nepovedlo se připravit exportní canvas.')); return false; }

  const codecCandidates = [
    'avc1.64002A',
    'avc1.4d4028',
    'avc1.42E01E',
    'avc1.42001E'
  ];
  let encoderConfig = null;
  for(const codec of codecCandidates){
    const cfg = {
      codec,
      width: canvas.width,
      height: canvas.height,
      bitrate: getExportVideoBitrate(16000000),
      framerate: fps,
      avc: { format: 'annexb' }
    };
    try{
      const support = await VideoEncoder.isConfigSupported(cfg);
      if(support && support.supported){
        encoderConfig = support.config || cfg;
        break;
      }
    }catch(err){}
  }
  if(!encoderConfig) return false;

  const oldElapsed = state.animElapsed;
  const oldPlaying = state.animPlaying;
  stopAnimation();
  setStatus(t('Exportuji MP4 / H.264…'));

  try{
    const target = new ArrayBufferTarget();
    const muxer = new Muxer({
      target,
      fastStart: 'in-memory',
      video: {
        codec: 'avc',
        width: canvas.width,
        height: canvas.height,
        frameRate: fps
      }
    });

    let encoderError = null;
    const encoder = new VideoEncoder({
      output: (chunk, meta) => muxer.addVideoChunk(chunk, meta),
      error: err => {
        console.error(err);
        encoderError = err;
      }
    });
    encoder.configure(encoderConfig);

    const delay = parseFloat($('animStart')?.value || '0');
    const dur = Math.max(0.001, parseFloat($('animDuration')?.value || '8'));
    const frameDurationUs = Math.round(1000000 / fps);

    for(let i=0;i<frames;i++){
      const elapsed = Math.min(total, i / fps);
      state.animElapsed = elapsed;
      const progress = elapsed <= delay ? 0 : Math.min(1, (elapsed - delay) / dur);
      setAnimProgress(progress);
      await waitMapRender(24);
      await drawCurrentMapFrame(canvas);
      const vf = new VideoFrame(canvas, {
        timestamp: i * frameDurationUs,
        duration: frameDurationUs
      });
      encoder.encode(vf, { keyFrame: i === 0 || (i % Math.max(1, fps * 2) === 0) });
      vf.close();
      if(encoderError) throw encoderError;
      if(i % 10 === 0) await wait(0);
    }

    await encoder.flush();
    encoder.close();
    if(encoderError) throw encoderError;
    muxer.finalize();
    const buffer = target.buffer;
    const blob = new Blob([buffer], { type: 'video/mp4' });
    restoreAnimationState(oldElapsed, oldPlaying);
    const fname = videoExportName('.mp4');
    downloadBlob(fname, blob);
    setStatus(t('MP4 / H.264 video staženo.'));
    return fname;
  }catch(err){
    console.warn('Exact MP4 export failed', err);
    restoreAnimationState(oldElapsed, oldPlaying);
    return false;
  }
}

async function exportMp4H264Direct(){
  const exactOk = await exportMp4H264Exact();
  if(exactOk) return exactOk;
  return exportRecordedVideo({
    mimeCandidates: buildMp4MimeCandidates(),
    extension: '.mp4',
    startStatusKey: 'Exportuji MP4 / H.264…',
    doneStatusKey: 'MP4 / H.264 video staženo.',
    unsupportedStatusKey: 'MP4 / H.264 není v tomto prohlížeči přímo dostupné.',
    bitsPerSecond: getExportVideoBitrate(16000000)
  });
}

function buildFfmpegPackageFiles(format, fps){
  const isMov = format === 'mov444';
  const outputName = isMov ? 'output_prores4444.mov' : 'output_h264.mp4';
  const bat = isMov
    ? `ffmpeg -framerate ${fps} -i frame_%05d.png -c:v prores_ks -profile:v 4 -pix_fmt yuva444p10le "${outputName}"
pause
`
    : `ffmpeg -framerate ${fps} -i frame_%05d.png -c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -movflags +faststart "${outputName}"
pause
`;
  const sh = isMov
    ? `#!/bin/bash
ffmpeg -framerate ${fps} -i frame_%05d.png -c:v prores_ks -profile:v 4 -pix_fmt yuva444p10le "${outputName}"
`
    : `#!/bin/bash
ffmpeg -framerate ${fps} -i frame_%05d.png -c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -movflags +faststart "${outputName}"
`;
  const readme = isMov
    ? [
        'Balíček pro MOV ProRes 4444',
        '',
        'Obsahuje PNG sekvenci a připravené FFmpeg skripty.',
        '1. Rozbal ZIP.',
        '2. Spusť convert_to_mov_4444.bat (Windows) nebo convert_to_mov_4444.command (macOS/Linux).',
        '3. Výstup bude ' + outputName,
        '',
        'Poznámka: browser neumí MOV 4444 exportovat přímo, proto je zde připravený balíček pro lokální převod.'
      ].join('\n')
    : [
        'Balíček pro MP4 / H.264',
        '',
        'Obsahuje PNG sekvenci a připravené FFmpeg skripty.',
        '1. Rozbal ZIP.',
        '2. Spusť convert_to_h264_mp4.bat (Windows) nebo convert_to_h264_mp4.command (macOS/Linux).',
        '3. Výstup bude ' + outputName,
        '',
        'Tento fallback se hodí, když browser neumí přímý MP4 / H.264 export.'
      ].join('\n');
  return {
    readmeName: 'README.txt',
    readme,
    batName: isMov ? 'convert_to_mov_4444.bat' : 'convert_to_h264_mp4.bat',
    bat,
    shName: isMov ? 'convert_to_mov_4444.command' : 'convert_to_h264_mp4.command',
    sh
  };
}

async function exportFramePackage(format){
  if(!state.routeCoords.length && !cameraAnimReady()){ setStatus(t('Nejdřív najdi trasu nebo nastav kameru.')); return false; }
  if(typeof JSZip === 'undefined'){ setStatus(t('Nepodařilo se načíst JSZip.')); return false; }
  const fps = Number($('exportFps')?.value || '25');
  const total = animationTotal();
  const frames = Math.max(1, Math.round(total * fps));
  const canvas = document.createElement('canvas');
  if(!(await drawCurrentMapFrame(canvas))){ setStatus(t('Nepovedlo se připravit exportní canvas.')); return false; }
  const zip = new JSZip();
  const oldElapsed = state.animElapsed;
  const oldPlaying = state.animPlaying;
  stopAnimation();
  setStatus(t(format === 'mov444' ? 'Připravuji balíček pro MOV 4444…' : 'Připravuji balíček pro MP4 / H.264…'));
  for(let i=0;i<frames;i++){
    const elapsed = i / fps;
    state.animElapsed = Math.min(total, elapsed);
    const delay = parseFloat($('animStart')?.value || '0');
    const dur = Math.max(0.001, parseFloat($('animDuration')?.value || '8'));
    const progress = elapsed <= delay ? 0 : Math.min(1, (elapsed - delay) / dur);
    setAnimProgress(progress);
    await waitMapRender();
    await drawCurrentMapFrame(canvas);
    const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/png'));
    zip.file('frame_' + String(i).padStart(5,'0') + '.png', blob);
  }
  const files = buildFfmpegPackageFiles(format, fps);
  zip.file(files.readmeName, files.readme);
  zip.file(files.batName, files.bat);
  zip.file(files.shName, files.sh);
  const blob = await zip.generateAsync({ type: 'blob' });
  restoreAnimationState(oldElapsed, oldPlaying);
  const suffix = format === 'mov444' ? 'mov444-package.zip' : 'h264-package.zip';
  const fname = slugifyName(($('presetName')?.value || 'map-video')) + '-' + suffix;
  downloadBlob(fname, blob);
  setStatus(t(format === 'mov444' ? 'Balíček pro MOV 4444 stažen.' : 'Balíček pro MP4 / H.264 stažen.'));
