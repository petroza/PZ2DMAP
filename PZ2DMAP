function applyMapLabelSizeToAll(sizeValue){
  const size = Math.max(14, Math.min(80, parseInt(sizeValue ?? state.mapLabelGlobalSize ?? $('mapLabelSize')?.value ?? '28', 10) || 28));
  state.mapLabelGlobalSize = size;
