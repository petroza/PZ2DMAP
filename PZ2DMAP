function scalePaintWidthExpression(expr, scale){
  const s = Number(scale);
  if(!Number.isFinite(s)) return expr;
  if(typeof expr === 'number') return Math.max(0, expr * s);
  if(!Array.isArray(expr)) return expr;
  const op = expr[0];
  if(op === 'interpolate' || op === 'interpolate-hcl' || op === 'interpolate-lab'){
    const out = expr.slice();
    for(let i = 4; i < out.length; i += 2){
      if(typeof out[i] === 'number') out[i] = Math.max(0, out[i] * s);
    }
    return out;
  }
  if(op === 'step'){
    const out = expr.slice();
    if(typeof out[2] === 'number') out[2] = Math.max(0, out[2] * s);
    for(let i = 4; i < out.length; i += 2){
      if(typeof out[i] === 'number') out[i] = Math.max(0, out[i] * s);
    }
    return out;
  }
  if(op === 'match'){
    const out = expr.slice();
    for(let i = 2; i < out.length; i += 2){
      if(i === out.length - 1){
        if(typeof out[i] === 'number') out[i] = Math.max(0, out[i] * s);
      } else if(typeof out[i + 1] === 'number') {
        out[i + 1] = Math.max(0, out[i + 1] * s);
      }
    }
    return out;
  }
  return expr;
}

function getControlledBoundaryLayers(){
  const all = matchLayers(/boundary|admin/, 'line');
  const country = all.filter(layer => {
    const id = (layer.id || '').toLowerCase();
    const sourceLayer = (layer['source-layer'] || '').toLowerCase();
    let filterText = '';
    try{ filterText = JSON.stringify(layer.filter || '').toLowerCase(); }catch(e){}
    const hay = `${id} ${sourceLayer} ${filterText}`;

    // Nižší administrativní hranice (kraje, regiony, provincie) nechceme zobrazovat jako výchozí.
    if(/admin[_-]?level[^0-9]*[3-9]|adm[1-9]|province|region|state|county|voivodeship|subdivision|municipal|district|kraj/.test(hay)) return false;

    // Státní hranice – různé styly je značí různě.
    return /country|admin[_-]?level[^0-9]*2|adm0|admin0|boundary[_-]?(country|2)|country[_-]?boundary|boundary[_-]?national|national[_-]?boundary/.test(hay);
  });

  const target = country.length ? country : all;
  const targetIds = new Set(target.map(l => l.id));
  return {all, target, hidden: country.length ? all.filter(l => !targetIds.has(l.id)) : []};
}

function applyControlledBoundaryVisibility(visible){
  const groups = getControlledBoundaryLayers();
  groups.target.forEach(l => safeSetLayout(l.id, 'visibility', visible ? 'visible' : 'none'));
  // Pokud styl umí rozlišit státní hranice, krajské/regionální hranice necháme schované.
  groups.hidden.forEach(l => safeSetLayout(l.id, 'visibility', 'none'));
}


function expressionContainsRoadRef(expr){
  const hay = JSON.stringify(expr || '').toLowerCase();
  return /\b(ref|route_?number|shield|network|class)\b/.test(hay);
}

function isRoadShieldLayer(layer){
  if(!layer || layer.type !== 'symbol') return false;
  const id = String(layer.id || '').toLowerCase();
  const src = String(layer['source-layer'] || '').toLowerCase();
  const layout = layer.layout || {};
  const icon = JSON.stringify(layout['icon-image'] || '').toLowerCase();
  const textField = layout['text-field'];
  const text = JSON.stringify(textField || '').toLowerCase();
  const filter = (() => { try{ return JSON.stringify(layer.filter || '').toLowerCase(); }catch(e){ return ''; } })();
  const hay = `${id} ${src} ${icon} ${text} ${filter}`;

  // Explicit shield / road-number layers from common OSM vector styles.
  if(/(road|highway|motorway|trunk|primary|route|transportation).*(shield|number|ref)|shield.*(road|highway|route)|road_?number|road_?ref/.test(id)) return true;
  if(/(shield|road_?number|road_?ref|route_?number|motorway.*junction)/.test(icon)) return true;
  if(/(shield|road_?number|road_?ref|route_?number|highway_?shield)/.test(hay)) return true;

  // Některé styly kreslí štítky silnic jako běžný symbol bez slova "shield" v názvu vrstvy.
  // Typický znak je text-field založený na ref / route-number a silniční source-layer.
  const looksLikeRoadLayer = /(road|highway|motorway|trunk|primary|secondary|tertiary|route|transportation)/.test(id) || /(road|highway|transportation|transportation_name)/.test(src);
  const usesRefText = expressionContainsRoadRef(textField) || /\b(ref|route_?number|network|shield)\b|\{ref\}|\{route_?number\}/.test(text);
  const usesShieldIcon = /shield|road|motorway|trunk|primary|route/.test(icon);
  const textIsMostlyRef = usesRefText && !/\b(name|name:[a-z]{2}|name_)/.test(text);

  return looksLikeRoadLayer && (usesShieldIcon || textIsMostlyRef);
}

function enforceRoadShieldToggle(){
