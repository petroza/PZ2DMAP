function applySavedTabOrder(){
  const wrap = getTabButtonsWrap();
  if(!wrap) return;
  let saved = [];
  try{ saved = JSON.parse(localStorage.getItem(TAB_ORDER_KEY) || '[]'); }catch(e){ saved = []; }
  if(!Array.isArray(saved) || !saved.length) return;
  const buttons = [...wrap.querySelectorAll('.tab-btn')];
  const map = new Map(buttons.map(btn => [btn.dataset.tab, btn]));
  saved.forEach(tab => {
    const btn = map.get(tab);
    if(btn) wrap.appendChild(btn);
  });
  buttons.forEach(btn => {
    if(btn.parentElement === wrap) return;
    wrap.appendChild(btn);
  });
}

function initTabReorder(){
  const wrap = getTabButtonsWrap();
  if(!wrap) return;
  let dragged = null;

  const clearDropMarks = () => {
    wrap.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('drop-before','drop-after','dragging'));
  };

  wrap.querySelectorAll('.tab-btn').forEach(btn => {
    btn.setAttribute('draggable','true');
    btn.addEventListener('dragstart', () => {
      dragged = btn;
      btn.classList.add('dragging');
    });
    btn.addEventListener('dragend', () => {
      clearDropMarks();
      dragged = null;
      saveTabOrder();
    });
    btn.addEventListener('dragover', ev => {
      if(!dragged || dragged === btn) return;
      ev.preventDefault();
      const rect = btn.getBoundingClientRect();
      const before = ev.clientX < rect.left + rect.width / 2;
      btn.classList.toggle('drop-before', before);
      btn.classList.toggle('drop-after', !before);
    });
    btn.addEventListener('dragleave', () => {
      btn.classList.remove('drop-before','drop-after');
    });
    btn.addEventListener('drop', ev => {
      if(!dragged || dragged === btn) return;
      ev.preventDefault();
      const rect = btn.getBoundingClientRect();
      const before = ev.clientX < rect.left + rect.width / 2;
      if(before) wrap.insertBefore(dragged, btn);
      else wrap.insertBefore(dragged, btn.nextSibling);
      clearDropMarks();
      saveTabOrder();
    });
  });
}


