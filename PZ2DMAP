function buildMatchColorExpression(mapObj, defaultColor){
  const entries = Object.entries(mapObj || {}).filter(([id, color]) => !!id && !!color);
  if(!entries.length) return defaultColor;
  const expr = ['match', ['get', '__appId']];
  entries.forEach(([id, color]) => {
    expr.push(id, color);
  });
  expr.push(defaultColor);
  return expr;
}

