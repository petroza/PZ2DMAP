function parseLatLng(text){
  const m = String(text||'').trim().match(/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/);
  if(!m) return null;
  return [parseFloat(m[2]), parseFloat(m[1])];
}

function getSearchAcceptLanguage(lang){
  const key = String(lang || currentLang || 'cs').toLowerCase();
  const prefs = {
    cs:['cs','sk','en'],
    sk:['sk','cs','en'],
    bg:['bg','en','cs'],
    hr:['hr','sr','bs','en','cs'],
    ro:['ro','en','cs'],
    en:['en','cs','sk']
  };
  return Array.from(new Set([key, ...(prefs[key] || ['en']), 'en'])).join(',');
}

function getNominatimFetchOptions(){
  return {
    headers:{
      'Accept':'application/json',
      'Accept-Language': getSearchAcceptLanguage(currentLang)
    }
  };
}

function normalizePlaceLabel(item){
  return String(item?.display_name || item?.name || '').replace(/\s*,\s*/g, ', ').trim();
}

function placePointFromItem(item){
  return [parseFloat(item.lon), parseFloat(item.lat)];
}

function getPlaceResultMeta(item){
  const parts = [];
  const type = item?.addresstype || item?.type || '';
  const cls = item?.class || '';
  if(type) parts.push(type);
  if(cls && cls !== type) parts.push(cls);
  return parts.join(' · ');
}

function getPlaceZoom(item){
  const key = String(item?.addresstype || item?.type || '').toLowerCase();
  if(/country/.test(key)) return 4;
  if(/state|region|province|county/.test(key)) return 6;
  if(/city|town|municipality/.test(key)) return 10;
  if(/village|hamlet|suburb|neighbourhood|neighborhood/.test(key)) return 12;
  if(/road|street|residential|quarter/.test(key)) return 14;
  return 13;
}

function getBoundsFromPlaceItem(item){
  const bb = item?.boundingbox;
  if(!Array.isArray(bb) || bb.length !== 4) return null;
  const south = parseFloat(bb[0]), north = parseFloat(bb[1]), west = parseFloat(bb[2]), east = parseFloat(bb[3]);
  if(!isFinite(south) || !isFinite(north) || !isFinite(west) || !isFinite(east)) return null;
  return new maplibregl.LngLatBounds([west, south], [east, north]);
}

async function searchPlaces(query, limit=8){
  const q = String(query || '').trim();
  if(!q) return [];
  const url = new URL('https://nominatim.openstreetmap.org/search');
  url.searchParams.set('format', 'jsonv2');
  url.searchParams.set('addressdetails', '1');
  url.searchParams.set('namedetails', '1');
  url.searchParams.set('limit', String(Math.max(1, Math.min(10, limit))));
  url.searchParams.set('q', q);
  url.searchParams.set('accept-language', getSearchAcceptLanguage(currentLang));
  const res = await fetch(url.toString(), getNominatimFetchOptions());
  if(!res.ok) throw new Error('Geocoding failed');
  return await res.json();
}

async function geocode(q){
  const parsed = parseLatLng(q);
  if(parsed) return { lon: parsed[0], lat: parsed[1], display_name: `${parsed[1].toFixed(5)}, ${parsed[0].toFixed(5)}`, boundingbox: null };
  const data = await searchPlaces(q, 1);
  if(!data || !data.length) throw new Error('Nenalezeno');
  return data[0];
}

async function reverseGeocode(lngLat, zoom=10){
  const [lng, lat] = lngLat;
  const url = new URL('https://nominatim.openstreetmap.org/reverse');
  url.searchParams.set('format', 'jsonv2');
  url.searchParams.set('lat', String(lat));
  url.searchParams.set('lon', String(lng));
  url.searchParams.set('zoom', String(zoom));
  url.searchParams.set('addressdetails', '1');
  url.searchParams.set('namedetails', '1');
  url.searchParams.set('accept-language', getSearchAcceptLanguage(currentLang));
  const res = await fetch(url.toString(), getNominatimFetchOptions());
  if(!res.ok) throw new Error('Reverse geocoding failed');
  return await res.json();
}

function clearPlaceSearchMarker(){
  if(state.placeSearchMarker){
    state.placeSearchMarker.remove();
    state.placeSearchMarker = null;
  }
}

function clearPlaceSearchResults(){
  state.placeSearchResults = [];
  const box = $('placeSearchResults');
  if(box){
    box.innerHTML = '';
    box.hidden = true;
  }
}

function renderPlaceSearchResults(items){
  const box = $('placeSearchResults');
  if(!box) return;
  box.innerHTML = '';
  const list = Array.isArray(items) ? items : [];
  if(!list.length){
    box.hidden = true;
    return;
  }
  box.hidden = false;
  list.forEach(item => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'place-search-item';
    const title = document.createElement('span');
    title.className = 'place-search-title';
    title.textContent = normalizePlaceLabel(item) || `${parseFloat(item.lat).toFixed(5)}, ${parseFloat(item.lon).toFixed(5)}`;
    btn.appendChild(title);
    const meta = getPlaceResultMeta(item);
    if(meta){
      const sub = document.createElement('span');
      sub.className = 'place-search-sub';
      sub.textContent = meta;
      btn.appendChild(sub);
    }
    btn.addEventListener('click', ()=> focusPlaceResult(item));
    box.appendChild(btn);
  });
}

function focusPlaceResult(item){
  if(!state.map) return;
  const point = placePointFromItem(item);
  const bounds = getBoundsFromPlaceItem(item);
  if(bounds && !bounds.isEmpty()){
    state.map.fitBounds(bounds, {padding:getFitPadding(), duration:900, maxZoom:getPlaceZoom(item)});
  }else{
    state.map.flyTo({center:point, zoom:getPlaceZoom(item), duration:900});
  }
  clearPlaceSearchMarker();
  state.placeSearchMarker = new maplibregl.Marker({color:'#e63946'}).setLngLat(point).addTo(state.map);
  if($('placeSearchInput')) $('placeSearchInput').value = normalizePlaceLabel(item) || $('placeSearchInput').value;
  setStatus(t('Místo nalezeno.'));
}

async function performPlaceSearch({focusFirst=false, keepList=true} = {}){
  const query = $('placeSearchInput')?.value?.trim() || '';
  if(!query){
    clearPlaceSearchResults();
    return;
  }
  const token = ++state.placeSearchToken;
  setStatus(t('Hledám místo…'));
  try{
    const items = await searchPlaces(query, 8);
    if(token !== state.placeSearchToken) return;
    state.placeSearchResults = items;
    renderPlaceSearchResults(items);
    if(!items.length){
      setStatus(t('Místo nenalezeno.'));
      return;
    }
    if(focusFirst) focusPlaceResult(items[0]);
    else setStatus(t('Vyber místo ze seznamu.'));
    if(!keepList && items.length) clearPlaceSearchResults();
  }catch(e){
    console.error(e);
    if(token !== state.placeSearchToken) return;
    clearPlaceSearchResults();
    setStatus(t('Místo nenalezeno.'));
  }
}

function clearPlaceSearch(){
  state.placeSearchToken++;
  if($('placeSearchInput')) $('placeSearchInput').value = '';
  clearPlaceSearchResults();
  clearPlaceSearchMarker();
  setStatus(t('Vyhledávání místa smazáno.'));
}

let placeSearchDebounce = null;
function queuePlaceSearchSuggest(){
  clearTimeout(placeSearchDebounce);
  const query = $('placeSearchInput')?.value?.trim() || '';
  if(query.length < 2){
    clearPlaceSearchResults();
    return;
  }
  placeSearchDebounce = setTimeout(()=> performPlaceSearch({focusFirst:false, keepList:true}), 260);
}

// ===== Navigation A/B fulltext autocomplete =====
const _navSuggestState = {
  startInput: { token: 0, debounce: null, items: [], activeIdx: -1 },
  endInput:   { token: 0, debounce: null, items: [], activeIdx: -1 }
};

function _navSuggestBox(id){ return document.getElementById(id + 'Suggest'); }

function closeNavSuggest(id){
  const box = _navSuggestBox(id);
  if(!box) return;
  box.dataset.open = '0';
  box.innerHTML = '';
  const st = _navSuggestState[id];
  if(st){ st.items = []; st.activeIdx = -1; }
}

function renderNavSuggest(id, items){
  const box = _navSuggestBox(id);
  if(!box) return;
  const st = _navSuggestState[id];
  st.items = items || [];
  st.activeIdx = items && items.length ? 0 : -1;
  box.innerHTML = '';
  if(!items || !items.length){
    const empty = document.createElement('div');
    empty.className = 'nav-suggest-empty';
    empty.textContent = (typeof t === 'function' ? t('Místo nenalezeno.') : 'Místo nenalezeno.');
    box.appendChild(empty);
  } else {
    items.forEach((item, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'nav-suggest-item' + (idx === 0 ? ' active' : '');
      btn.dataset.idx = String(idx);
      const title = document.createElement('span');
      title.textContent = (typeof normalizePlaceLabel === 'function' ? normalizePlaceLabel(item) : '') ||
                          `${parseFloat(item.lat).toFixed(5)}, ${parseFloat(item.lon).toFixed(5)}`;
      btn.appendChild(title);
      const metaText = (typeof getPlaceResultMeta === 'function') ? getPlaceResultMeta(item) : '';
      if(metaText){
        const sub = document.createElement('span');
        sub.className = 'nav-suggest-sub';
        sub.textContent = metaText;
        btn.appendChild(sub);
      }
      btn.addEventListener('mousedown', (e) => { e.preventDefault(); });
      btn.addEventListener('click', () => pickNavSuggest(id, idx));
      box.appendChild(btn);
    });
  }
  box.dataset.open = '1';
}

function moveNavSuggest(id, delta){
  const box = _navSuggestBox(id);
  const st = _navSuggestState[id];
  if(!box || !st || !st.items.length) return;
  const n = st.items.length;
  st.activeIdx = (st.activeIdx + delta + n) % n;
  [...box.querySelectorAll('.nav-suggest-item')].forEach((el, i) => {
    el.classList.toggle('active', i === st.activeIdx);
  });
  const active = box.querySelector('.nav-suggest-item.active');
  if(active) active.scrollIntoView({ block: 'nearest' });
}

async function queueNavSuggest(id){
  const input = document.getElementById(id);
  if(!input) return;
  const st = _navSuggestState[id];
  const query = (input.value || '').trim();
  clearTimeout(st.debounce);
  if(query.length < 2){ closeNavSuggest(id); return; }
  const token = ++st.token;
  st.debounce = setTimeout(async () => {
    try {
      const items = await searchPlaces(query, 8);
      if(token !== st.token) return;
      renderNavSuggest(id, items || []);
    } catch(e){
      if(token !== st.token) return;
      closeNavSuggest(id);
    }
  }, 260);
}

function pickNavSuggest(id, idx){
  const st = _navSuggestState[id];
  if(!st) return;
  const item = st.items[idx];
  if(!item) return;
  const lon = parseFloat(item.lon), lat = parseFloat(item.lat);
  if(!isFinite(lon) || !isFinite(lat)) return;
  const lngLat = [lon, lat];
  const label = (typeof normalizePlaceLabel === 'function' ? normalizePlaceLabel(item) : '') || `${lat.toFixed(5)}, ${lon.toFixed(5)}`;
  const input = document.getElementById(id);
  if(input) input.value = label;
  const pointType = (id === 'startInput') ? 'A' : 'B';
  if(pointType === 'A'){
    state.pointA = lngLat;
    if(state.markerA) state.markerA.remove();
    state.markerA = createRoutePointMarker('A', lngLat);
    state.clickPhase = state.pointB ? 'done' : 'B';
  } else {
    state.pointB = lngLat;
    if(state.markerB) state.markerB.remove();
    state.markerB = createRoutePointMarker('B', lngLat);
    state.clickPhase = 'done';
  }
  try {
    const bounds = (typeof getBoundsFromPlaceItem === 'function') ? getBoundsFromPlaceItem(item) : null;
    if(bounds && !bounds.isEmpty && !bounds.isEmpty()){
      state.map.fitBounds(bounds, { padding: (typeof getFitPadding === 'function' ? getFitPadding() : 60), duration: 700, maxZoom: (typeof getPlaceZoom === 'function' ? getPlaceZoom(item) : 13) });
    } else {
      state.map.flyTo({ center: lngLat, zoom: (typeof getPlaceZoom === 'function' ? getPlaceZoom(item) : 13), duration: 700 });
    }
  } catch(e){}
  closeNavSuggest(id);
  try { if(typeof refreshRoutePointSelection === 'function') refreshRoutePointSelection(); } catch(e){}
  if(state.pointA && state.pointB){ try { findRoute(); } catch(e){} }
  else setStatus((typeof t === 'function' ? t(pointType === 'A' ? 'Bod A nastaven. Klikni do mapy pro bod B.' : 'Bod B nastaven.') : ''));
}

