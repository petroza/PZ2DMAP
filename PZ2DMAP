function updateSceneIcon(id, updates={}){
  const item = getSceneIconById(id);
  if(!item) return;
  if(updates.size != null) item.size = Math.max(16, parseInt(updates.size, 10) || 30);
  if(updates.data != null) item.data = updates.data;
  const el = item.marker?.getElement?.();
  if(el){
    el.style.width = item.size + 'px';
    el.style.height = item.size + 'px';
    const img = el.querySelector('img');
    if(img && item.data) img.src = item.data;
  }
  renderSceneIconList();
}

