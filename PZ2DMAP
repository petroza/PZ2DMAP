Object.keys(I18N).forEach(key => {
  if (!I18N[key] || typeof I18N[key] !== 'object') return;
  if (!Object.prototype.hasOwnProperty.call(I18N[key], 'en')) {
    I18N[key].en = EN_OVERRIDES[key] || I18N[key].cs || key;
  } else if (EN_OVERRIDES[key]) {
    I18N[key].en = EN_OVERRIDES[key];
  }
});

function t(key, ...args) {
  const entry = I18N[key];
  if (!entry) return key;
  let text = entry[currentLang] || entry['cs'] || key;
  args.forEach((a, i) => { text = text.replace(`{${i}}`, a); });
  return text;
}

function applyLang(lang) {
  currentLang = lang;
  localStorage.setItem('mapLang', lang);
  setTimeout(applyPreferredMapLabelLanguage, 0);
  setTimeout(applyPreferredMapLabelLanguage, 120);

  // Update lang buttons
  document.querySelectorAll('.lang-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.lang === lang);
  });

  // Update data-i18n elements
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const key = el.dataset.i18n;
    const entry = I18N[key];
    if (!entry) return;
    const text = entry[lang] || entry['cs'] || key;
    // Preserve child elements (like .badge spans, .val spans)
    const children = Array.from(el.childNodes).filter(n => n.nodeType === 1);
    if (children.length > 0) {
      // Find first text node and replace it
      for (const n of el.childNodes) {
        if (n.nodeType === 3 && n.textContent.trim()) {
          n.textContent = text + ' ';
          break;
        }
      }
    } else {
      el.textContent = text;
    }
  });

  // Update data-i18n-label (optgroup)
  document.querySelectorAll('[data-i18n-label]').forEach(el => {
    const key = el.dataset.i18nLabel;
    const entry = I18N[key];
    if (entry) el.label = entry[lang] || entry['cs'] || key;
  });

  // Update placeholders
  const phMap = {
    'presetName': 'ph_preset',
    'startInput': 'ph_start',
    'endInput': 'ph_end',
    'mapLabelText': 'ph_label',
    'placeSearchInput': 'ph_place_search',
    'politicalCountrySearch': 'ph_country_search',
    'czRegionSearch': 'ph_region_search',
    'projectName': 'ph_project',
  };
  for (const [id, key] of Object.entries(phMap)) {
    const el = document.getElementById(id);
    if (el) el.placeholder = t(key);
  }
  // Select default option
  const selPreset = document.getElementById('savedPresetSelect');
  if (selPreset && selPreset.options[0]) selPreset.options[0].textContent = t('ph_select');

  // Update titles
  const titleMap = {
    'animRewindBtn': 'Na začátek',
    'animPlayBtn': 'Přehrát',
    'animPauseBtn': 'Pauza',
    'animStopBtn': 'Stop',
  };
  for (const [id, key] of Object.entries(titleMap)) {
    const el = document.getElementById(id);
    if (el) el.title = t(key);
  }

  // Update hint texts
  const hints = document.querySelectorAll('.hint');
