function closeCountrySuggest(){
  const box = $('politicalCountrySearchSuggest');
  if(!box) return;
  box.dataset.open = '0';
  box.innerHTML = '';
  _countrySuggestState.items = [];
  _countrySuggestState.activeIdx = -1;
}

function renderCountrySuggest(items){
  const box = $('politicalCountrySearchSuggest');
  if(!box) return;
  _countrySuggestState.items = items || [];
  _countrySuggestState.activeIdx = items && items.length ? 0 : -1;
  box.innerHTML = '';
  if(!items || !items.length){
    const empty = document.createElement('div');
    empty.className = 'nav-suggest-empty';
    empty.textContent = 'Stát nenalezen.';
    box.appendChild(empty);
  }else{
    items.forEach((item, idx) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'nav-suggest-item' + (idx === 0 ? ' active' : '');
      btn.dataset.idx = String(idx);
      const title = document.createElement('span');
      title.textContent = item.name;
      btn.appendChild(title);
      const sub = document.createElement('span');
      sub.className = 'nav-suggest-sub';
      sub.textContent = item.iso ? (item.iso + ' · stát') : 'stát';
      btn.appendChild(sub);
      btn.addEventListener('mousedown', e => e.preventDefault());
      btn.addEventListener('click', () => pickCountrySuggest(idx));
      box.appendChild(btn);
    });
  }
  box.dataset.open = '1';
}

function queueCountrySuggest(){
  const input = $('politicalCountrySearch');
  if(!input) return;
  const q = String(input.value || '').trim();
  clearTimeout(_countrySuggestState.debounce);
  if(q.length < 1){ closeCountrySuggest(); return; }
  _countrySuggestState.debounce = setTimeout(() => {
    renderCountrySuggest(getCountrySearchItems(q));
  }, 80);
}

function moveCountrySuggest(delta){
  const box = $('politicalCountrySearchSuggest');
  const st = _countrySuggestState;
  if(!box || !st.items.length) return;
  const n = st.items.length;
  st.activeIdx = (st.activeIdx + delta + n) % n;
  [...box.querySelectorAll('.nav-suggest-item')].forEach((el, i) => el.classList.toggle('active', i === st.activeIdx));
  const active = box.querySelector('.nav-suggest-item.active');
  if(active) active.scrollIntoView({block:'nearest'});
}

