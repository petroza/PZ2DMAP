// ====== Map action buttons: Refresh + Undo ======
(function setupMapActions(){
  const UNDO_LIMIT = 40;
  const undoStack = [];
  let applyingUndo = false;

  function snapshotNow(){
    try { return JSON.parse(JSON.stringify(serializeProjectSnapshot())); }
    catch(e){ return null; }
  }
  function updateUndoBtn(){
    const btn = $('undoActionBtn');
    if(btn) btn.disabled = undoStack.length === 0;
  }
  function pushUndo(){
    if(applyingUndo) return;
    const snap = snapshotNow();
    if(!snap) return;
    // Don't push duplicates of the last snapshot
    const last = undoStack[undoStack.length - 1];
    if(last && JSON.stringify(last) === JSON.stringify(snap)) return;
    undoStack.push(snap);
    if(undoStack.length > UNDO_LIMIT) undoStack.shift();
    updateUndoBtn();
  }
  function doUndo(){
    if(!undoStack.length) return;
    const snap = undoStack.pop();
    applyingUndo = true;
    try {
      applyProjectSnapshot(snap);
      setStatus(t ? t('Krok zpět.') : 'Krok zpět.');
    } finally {
      setTimeout(() => { applyingUndo = false; updateUndoBtn(); }, 200);
    }
    updateUndoBtn();
  }

  // Snapshot before destructive/important button actions (delegated).
  // Any button whose id is in this set triggers an undo push before its own
  // click handler runs (capture phase).
  const MUTATING_BUTTON_IDS = new Set([
    'clearRouteBtn','clearFlightWaypointsBtn','clearSceneIconsBtn',
    'clearMapLabelsBtn','clearPoliticalPaintingBtn',
    'findRouteBtn','addWaypointBtn','addFlightWaypointBtn',
    'applyColorsBtn','applyPoliticalCountryColorBtn','applyCzRegionColorBtn',
    'savePresetBtn','loadPresetBtn','updatePresetBtn','deletePresetBtn','renamePresetBtn',
    'resetPoliticalSelectionBtn','resetCzSelectionBtn'
  ]);
  document.addEventListener('click', (e) => {
    const btn = e.target?.closest?.('button,[role="button"]');
    if(!btn || !btn.id) return;
    if(MUTATING_BUTTON_IDS.has(btn.id)) pushUndo();
  }, true);

  // Also snapshot on map clicks that may mutate state (adding route points,
  // scene icons, painting countries, etc.). We only push when a relevant mode
  // is active — prevents stack spam on plain pan/zoom.
  const mapEl = document.getElementById('map');
  if(mapEl){
    mapEl.addEventListener('mousedown', (e) => {
      if(e.button !== 0) return; // left-click only
      const routeActive = typeof isRouteTabActive === 'function' && isRouteTabActive();
      const painting = $('paintPoliticalCountryOnClick')?.checked || $('paintCzRegionOnClick')?.checked;
      const addingIcon = !!state.addingSceneIcon;
      const addingLabel = !!state.addingMapLabel;
      const addingFlight = !!state.addingFlightPoint;
      if(routeActive || painting || addingIcon || addingLabel || addingFlight){
        pushUndo();
      }
    }, true);
  }

  // Refresh map — reloads current base style
  const refreshBtn = $('refreshMapBtn');
  if(refreshBtn){
    refreshBtn.addEventListener('click', () => {
      refreshBtn.classList.add('spinning');
      try {
        if(typeof reloadStyle === 'function') reloadStyle();
        setStatus(t ? t('Mapa obnovena.') : 'Mapa obnovena.');
      } catch(e){ console.warn(e); }
      setTimeout(() => refreshBtn.classList.remove('spinning'), 900);
    });
  }

  // Undo button
  const undoBtn = $('undoActionBtn');
  if(undoBtn) undoBtn.addEventListener('click', doUndo);

  // Keyboard shortcuts: Ctrl/Cmd+Z = undo, R = refresh (when not typing)
  document.addEventListener('keydown', (e) => {
    const tag = (e.target?.tagName || '').toLowerCase();
    const isTyping = ['input','textarea','select'].includes(tag) || e.target?.isContentEditable;
    if((e.ctrlKey || e.metaKey) && !e.shiftKey && (e.key === 'z' || e.key === 'Z')){
      if(isTyping) return;
      e.preventDefault();
      doUndo();
    } else if(!isTyping && (e.key === 'r' || e.key === 'R') && !e.ctrlKey && !e.metaKey && !e.altKey){
      // avoid hijacking browser reload (Ctrl+R); only bare R
      if(refreshBtn){ e.preventDefault(); refreshBtn.click(); }
    }
  });

  updateUndoBtn();
})();

// ensureOverlaySetup() is called in map.on('load') — no need here

  // Mobile drawer + safe MapLibre resize
  function initMobileLayout(){
    const btn = $('mobileMenuBtn');
    const backdrop = $('mobileBackdrop');
    const sidebar = document.querySelector('.sidebar');
    const mq = window.matchMedia('(max-width: 980px)');
    if(!btn || !backdrop || !sidebar) return;

    const resizeMapSoon = () => {
      window.setTimeout(() => { try { state.map?.resize?.(); } catch(e){} }, 60);
      window.setTimeout(() => { try { state.map?.resize?.(); } catch(e){} }, 280);
    };
    const setOpen = (open) => {
      document.body.classList.toggle('mobile-panel-open', !!open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      resizeMapSoon();
    };

    btn.addEventListener('click', () => setOpen(!document.body.classList.contains('mobile-panel-open')));
    backdrop.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if(e.key === 'Escape' && document.body.classList.contains('mobile-panel-open')) setOpen(false);
    });

    document.querySelectorAll('.tab-btn').forEach(tab => {
      tab.addEventListener('click', () => {
        if(mq.matches) sidebar.scrollTop = 0;
        resizeMapSoon();
      });
    });

    window.addEventListener('resize', resizeMapSoon, {passive:true});
    window.addEventListener('orientationchange', resizeMapSoon, {passive:true});

    // On desktop, keep the panel in normal layout and clear overlay state.
    const syncMode = () => { if(!mq.matches) setOpen(false); resizeMapSoon(); };
    if(mq.addEventListener) mq.addEventListener('change', syncMode);
    else mq.addListener(syncMode);
    syncMode();
  }
  initMobileLayout();

})();
