function initAngleDial(){
  const dial = $('animAngleDial');
  if(!dial || dial.dataset.ready) return;
  dial.dataset.ready = '1';
  // Populate tick marks (every 30°, major every 90°)
  const ticksG = dial.querySelector('.angle-dial-ticks');
  if(ticksG){
    let svg = '';
    for(let a = 0; a < 360; a += 30){
      const rad = (a - 90) * Math.PI / 180;
      const major = a % 90 === 0;
      const r1 = major ? 34 : 37;
      const r2 = 42;
      const x1 = Math.cos(rad) * r1, y1 = Math.sin(rad) * r1;
      const x2 = Math.cos(rad) * r2, y2 = Math.sin(rad) * r2;
      svg += `<line x1="${x1.toFixed(2)}" y1="${y1.toFixed(2)}" x2="${x2.toFixed(2)}" y2="${y2.toFixed(2)}"${major ? ' class="major"' : ''}/>`;
    }
    ticksG.innerHTML = svg;
  }
  let dragging = false;
  const applyFromEvent = (e) => {
    const rect = dial.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    const dx = e.clientX - cx;
    const dy = e.clientY - cy;
    // atan2 with 0° pointing up (north), clockwise positive
    let deg = Math.atan2(dx, -dy) * 180 / Math.PI;
    // Normalize to [-180, 180]
    if(deg > 180) deg -= 360;
    if(deg < -180) deg += 360;
    if(e.shiftKey) deg = Math.round(deg / 15) * 15;
    else deg = Math.round(deg);
    if($('animManualAngle')) $('animManualAngle').value = String(deg);
    if($('animManualAngleNumber')) $('animManualAngleNumber').value = String(deg);
    syncAnimAngleInputs('dial');
    state.smoothAngle = null;
    if(typeof updateReadouts === 'function') updateReadouts();
    if(typeof refreshAnimatedMarkerPreview === 'function') refreshAnimatedMarkerPreview();
  };
  dial.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    dragging = true;
    try { dial.setPointerCapture(e.pointerId); } catch(_){}
    applyFromEvent(e);
  });
  dial.addEventListener('pointermove', (e) => { if(dragging) applyFromEvent(e); });
  const stop = (e) => {
    if(!dragging) return;
    dragging = false;
    try { dial.releasePointerCapture(e.pointerId); } catch(_){}
  };
  dial.addEventListener('pointerup', stop);
  dial.addEventListener('pointercancel', stop);
  dial.addEventListener('dblclick', () => {
    if($('animManualAngle')) $('animManualAngle').value = '0';
    if($('animManualAngleNumber')) $('animManualAngleNumber').value = '0';
    syncAnimAngleInputs('dial');
    state.smoothAngle = null;
    if(typeof updateReadouts === 'function') updateReadouts();
    if(typeof refreshAnimatedMarkerPreview === 'function') refreshAnimatedMarkerPreview();
  });
  // Keyboard nudge for a11y
  dial.setAttribute('tabindex', '0');
  dial.addEventListener('keydown', (e) => {
    const step = e.shiftKey ? 15 : 1;
    let cur = parseFloat($('animManualAngle')?.value || '0') || 0;
    if(e.key === 'ArrowLeft' || e.key === 'ArrowDown') cur -= step;
    else if(e.key === 'ArrowRight' || e.key === 'ArrowUp') cur += step;
    else return;
    e.preventDefault();
    cur = Math.max(-180, Math.min(180, Math.round(cur)));
    if($('animManualAngle')) $('animManualAngle').value = String(cur);
    if($('animManualAngleNumber')) $('animManualAngleNumber').value = String(cur);
    syncAnimAngleInputs('dial');
    state.smoothAngle = null;
    if(typeof updateReadouts === 'function') updateReadouts();
    if(typeof refreshAnimatedMarkerPreview === 'function') refreshAnimatedMarkerPreview();
  });
}

