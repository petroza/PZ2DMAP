function makeArc(start,end,steps=80){
  const [x1,y1]=start, [x2,y2]=end;
  const dx=x2-x1, dy=y2-y1;
  const dist=Math.hypot(dx,dy);
  if(!dist) return [start,end];
  let px=-dy/dist, py=dx/dist;
  if(py < 0){ px *= -1; py *= -1; }
  const lift=Math.max(0.12, Math.min(0.32, dist*0.22));
  const cx=(x1+x2)/2 + px*dist*lift;
  const cy=(y1+y2)/2 + py*dist*lift;
  const pts=[];
  for(let i=0;i<=steps;i++){
    const t=i/steps, mt=1-t;
    const x=mt*mt*x1 + 2*mt*t*cx + t*t*x2;
    const y=mt*mt*y1 + 2*mt*t*cy + t*t*y2;
    pts.push([x,y]);
  }
  return pts;
}

async function routeFromPoints(a,b,mode){
  const viaPoints = (state.manualViaPoints || []).map(pt => pt.lngLat);
  const allPoints = [a, ...viaPoints, b];
  if(mode === 'planeDirect') return allPoints;
  if(mode === 'planeArc'){
    const pts = [];
    allPoints.forEach((pt, idx) => {
      if(idx === 0) return;
      const leg = makeArc(allPoints[idx-1], pt, 100);
      pts.push(...(idx === 1 ? leg : leg.slice(1)));
    });
    return pts;
  }
  if(mode === 'planeCustom') return allPoints;
  const coordString = allPoints.map(pt => `${pt[0]},${pt[1]}`).join(';');
  let url = '';
  if(mode === 'cycle'){
    url = `https://routing.openstreetmap.de/routed-bike/route/v1/driving/${coordString}?overview=full&geometries=geojson`;
  } else if(mode === 'foot'){
    // Public router.project-osrm.org only serves the car profile, so walking
    // routes there silently fall back to driving. Use the OSRM-FOSSGIS foot
    // endpoint (same provider as the cycle profile) for real pedestrian routing.
    url = `https://routing.openstreetmap.de/routed-foot/route/v1/driving/${coordString}?overview=full&geometries=geojson`;
  } else {
    url = `https://router.project-osrm.org/route/v1/car/${coordString}?overview=full&geometries=geojson`;
  }
  const res = await fetch(url);
  const data = await res.json();
  if(!data.routes?.length) throw new Error('Trasa nenalezena');
  return data.routes[0].geometry.coordinates;
}

function getGhostRouteCoords(){
