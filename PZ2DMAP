function hasLooseAlias(normName, aliases){
  if(!normName) return false;
  return (aliases || []).some(alias => {
    const normAlias = normalizeLoose(alias);
    return normAlias && (normName === normAlias || normName.includes(normAlias) || normAlias.includes(normName));
  });
}

function reconcileCzRegionAssignments(features){
  if(!Array.isArray(features) || !features.length) return features;

  const pragueId = 'HLAVNI-MESTO-PRAHA';
  const centralId = 'STREDOCESKY-KRAJ';
  const pragueName = 'Hlavní město Praha';
  const centralName = 'Středočeský kraj';
  const pragueRef = CZ_REGION_REFERENCE.find(item => item.id === pragueId);
  const centralRef = CZ_REGION_REFERENCE.find(item => item.id === centralId);

  const withMeta = features.map((feature, idx) => {
    const rawName = getRawCzRegionName(feature);
    const normName = normalizeLoose(rawName);
    const area = getGeometryApproxArea(feature?.geometry);
    const center = getFeatureApproxCenter(feature) || [NaN, NaN];
    return {feature, idx, rawName, normName, area, center};
  });

  const finiteAreas = withMeta.filter(item => Number.isFinite(item.area) && item.area > 0).sort((a,b) => a.area - b.area);
  const smallest = finiteAreas[0] || null;

  const setOfficialMeta = (item, ref) => {
    if(!item || !ref) return;
    item.feature.properties.__appId = ref.id;
    item.feature.properties.__appName = ref.name;
  };

  // Praha musí být nejmenší polygon. Některé zdroje ji bohužel prohodí se Středočeským krajem.
  if(smallest && pragueRef) setOfficialMeta(smallest, pragueRef);

  const otherItems = withMeta.filter(item => item !== smallest);
  const scoreForCentral = item => {
    if(!centralRef) return -Infinity;
    let score = 0;
    if(item.feature?.properties?.__appId === centralId) score += 5000;
    if(item.feature?.properties?.__appId === pragueId) score += 2500; // typický duplicitní problém Praha/Středočeský
    if(hasLooseAlias(item.normName, [centralName, ...(centralRef.aliases || [])])) score += 4500;
    if(item.normName && /(stred|stredo|central bohemian)/.test(item.normName)) score += 2600;
    if(Number.isFinite(item.area)) score += Math.min(1200, item.area * 120);
    if(Array.isArray(item.center) && item.center.length >= 2 && Array.isArray(centralRef.center)){
      const dx = item.center[0] - centralRef.center[0];
      const dy = item.center[1] - centralRef.center[1];
      const dist2 = dx * dx + dy * dy;
      score += Math.max(0, 1000 - dist2 * 6000);
    }
    return score;
  };

  if(centralRef && otherItems.length){
    const centralBest = otherItems.slice().sort((a,b) => scoreForCentral(b) - scoreForCentral(a))[0];
    if(centralBest) setOfficialMeta(centralBest, centralRef);
  }

  // Pojistka: když po mapování stále chybí Středočeský kraj a existují dvě Prahy,
  // nech větší z nich jako Středočeský kraj.
  const pragueItems = withMeta.filter(item => item.feature?.properties?.__appId === pragueId)
    .sort((a,b) => (Number.isFinite(b.area) ? b.area : -Infinity) - (Number.isFinite(a.area) ? a.area : -Infinity));
  const hasCentral = withMeta.some(item => item.feature?.properties?.__appId === centralId);
  if(!hasCentral && pragueItems.length > 1 && centralRef){
    setOfficialMeta(pragueItems[0], centralRef);
  }

  // Pojistka: pokud je Praha omylem větší než Středočeský kraj, prohoď je.
  const pragueFeature = withMeta.find(item => item.feature?.properties?.__appId === pragueId);
  const centralFeature = withMeta.find(item => item.feature?.properties?.__appId === centralId);
  if(pragueFeature && centralFeature && Number.isFinite(pragueFeature.area) && Number.isFinite(centralFeature.area) && pragueFeature.area > centralFeature.area){
    setOfficialMeta(pragueFeature, centralRef);
    setOfficialMeta(centralFeature, pragueRef);
  }

  return features;
}

function normalizeCzRegionsGeoJSON(raw){
  const fc = featureCollectionFromAny(raw);
  const features = reconcileCzRegionAssignments((fc.features || []).map((feature, idx) => {
    const props = feature.properties || {};
    const meta = resolveCzRegionMeta(feature, idx);
    return {
      ...feature,
      properties:{...props, __appId:meta.id, __appName:meta.name}
    };
  }));
  
  // Řadíme podle plochy SESTUPNĚ: větší polygony se vykreslí první (dole),
  // menší polygony (Praha) se vykreslí poslední (navrch).
  // Tím Praha VŽDY překryje Středočeský kraj svou vlastní barvou.
  features.sort((a, b) => {
    const areaA = getGeometryApproxArea(a.geometry);
    const areaB = getGeometryApproxArea(b.geometry);
    return areaB - areaA;
  });

  return {type:'FeatureCollection', features};
}

async function fetchGeoJson(url){
  const res = await fetch(url, {cache:'force-cache'});
  if(!res.ok) throw new Error('GeoJSON fetch failed: ' + url + ' [' + res.status + ']');
  return await res.json();
}

async function fetchGeoJsonWithFallback(urls){
  let lastError = null;
  for(const url of urls){
    try{
      return await fetchGeoJson(url);
    }catch(err){
      lastError = err;
      console.warn('GeoJSON source failed', url, err);
    }
  }
  throw lastError || new Error('GeoJSON fetch failed');
}

