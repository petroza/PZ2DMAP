    const isBuiltin = btn.dataset.builtin === 'true';
    const key = btn.dataset.key || '';
    const id = btn.dataset.id || '';
    const token = isBuiltin ? ('builtin:' + key) : ('custom:' + id);
    const isActive = token === active;
    btn.classList.toggle('active', isActive);
    btn.classList.toggle('multi-selected', state.selectedPresetTokens.has(token));
  });
}

