async function ensureGeoDataLoaded(){
  if(state.countriesGeojson && state.czRegionsGeojson && state.countryBorderLinesGeojson) return true;
  if(state.geoDataLoading) return state.geoDataLoading;
  state.geoDataLoading = Promise.allSettled([
    fetchGeoJsonWithFallback(COUNTRY_SOURCE_URLS),
    fetchGeoJsonWithFallback(COUNTRY_BORDER_SOURCE_URLS),
    fetchGeoJsonWithFallback(CZ_REGIONS_SOURCE_URLS)
  ]).then(([countriesRes, countryBordersRes, regionsRes]) => {
    state.geoDataError = null;
    if(countriesRes.status === 'fulfilled'){
      state.countriesGeojson = normalizeCountryGeoJSON(countriesRes.value);
      populateCountrySelects();
    }else{
      console.error(countriesRes.reason);
      ['countryFocusSelect','politicalCountrySelect'].forEach(id => {
        const sel = $(id);
        if(sel) sel.innerHTML = '<option value="">Nepodařilo se načíst státy</option>';
      });
    }
    if(countryBordersRes.status === 'fulfilled'){
      state.countryBorderLinesGeojson = normalizeCountryBorderGeoJSON(countryBordersRes.value);
    }else{
      console.error(countryBordersRes.reason);
      state.countryBorderLinesGeojson = null;
    }
    if(regionsRes.status === 'fulfilled'){
      state.czRegionsGeojson = normalizeCzRegionsGeoJSON(regionsRes.value);
      populateCzRegionSelect();
    }else{
      console.error(regionsRes.reason);
      const regionSel = $('czRegionSelect');
      if(regionSel) regionSel.innerHTML = '<option value="">Nepodařilo se načíst kraje</option>';
    }
    const ok = !!(state.countriesGeojson || state.countryBorderLinesGeojson || state.czRegionsGeojson);
    if(!ok){
      const err = countriesRes.reason || countryBordersRes.reason || regionsRes.reason || new Error('GeoJSON fetch failed');
      state.geoDataError = String(err && err.message || err || 'unknown');
      setStatus('Nepodařilo se načíst politické vrstvy.');
    }
    return ok;
  }).catch(err => {
    console.error(err);
    state.geoDataError = String(err && err.message || err || 'unknown');
    setStatus('Nepodařilo se načíst politické vrstvy.');
    state.geoDataLoading = null;
    return false;
  });
  return state.geoDataLoading;
}

