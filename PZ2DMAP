function makeExportCameraFromFrame(outW, outH){
  const baseMap = state.map;
  const mapCanvas = baseMap?.getCanvas?.();
  if(!baseMap || !mapCanvas) return null;
  const mapRect = mapCanvas.getBoundingClientRect();
  let frameRect = mapRect;
  const frame = $('exportFrame');
  if($('showExportFrame')?.checked && frame && !frame.classList.contains('hidden')) frameRect = frame.getBoundingClientRect();

  // High-detail export: render the hidden map at the real output CSS size and force pixelRatio 1.
  // The previous version divided by devicePixelRatio. On phones/hi-DPI displays that produced
  // 7680×4320 pixels, but map detail was only around 1920×1080 and looked blurred.
  const pixelRatio = 1;
  const cssW = Math.max(1, Math.round(outW));
  const cssH = Math.max(1, Math.round(outH));
  const centerPx = [
    (frameRect.left - mapRect.left) + frameRect.width / 2,
    (frameRect.top - mapRect.top) + frameRect.height / 2
  ];
  const center = baseMap.unproject(centerPx);
  const zoomDelta = Math.log2(outW / Math.max(1, frameRect.width));
  return {
    center:[center.lng, center.lat],
    zoom:baseMap.getZoom() + zoomDelta,
    bearing:baseMap.getBearing(),
    pitch:baseMap.getPitch(),
    cssW, cssH,
    pixelRatio
  };
}

function createNativeExportMarkers(exportMap){
  const temp = {markerA:null, markerB:null, manualViaMarkers:[], sceneIcons:[], mapLabels:[], animatedMarker:null, animatedMarkerEl:null, markerCameraMode:null};
  if(state.pointA){
    temp.markerA = new maplibregl.Marker({element: makeDotMarker('A','dot-a')}).setLngLat(state.pointA).addTo(exportMap);
  }
  if(state.pointB){
    temp.markerB = new maplibregl.Marker({element: makeDotMarker('B','dot-b')}).setLngLat(state.pointB).addTo(exportMap);
  }
  (state.manualViaPoints || []).forEach((pt, idx) => {
    if(!pt?.lngLat) return;
    temp.manualViaMarkers.push(new maplibregl.Marker({element: makeViaMarker(idx)}).setLngLat(pt.lngLat).addTo(exportMap));
  });
  (state.sceneIcons || []).forEach(item => {
    if(!item?.lngLat || !item?.data) return;
    const el = createSceneIconElement(item.data, item.size || 30);
    const marker = new maplibregl.Marker({element:el, anchor:'center'}).setLngLat(item.lngLat).addTo(exportMap);
    temp.sceneIcons.push({...item, marker});
  });
  (state.mapLabels || []).forEach(item => {
    if(!item?.lngLat) return;
    const el = createMapLabelElement(item.text || 'Popisek', item.size || state.mapLabelGlobalSize || 28, item.side || 'right');
    const marker = new maplibregl.Marker({element:el, anchor:'center'}).setLngLat(item.lngLat).addTo(exportMap);
    temp.mapLabels.push({...item, marker});
  });
  if($('animDot')?.checked && state.routeCoords?.length){
    const progress = getCurrentAnimationProgress();
    const sliced = sliceLineByProgress(state.routeCoords, progress);
    const point = sliced.point;
    if(point){
      const size = parseInt($('animIconSize')?.value || '34',10);
      const cameraFacing = !!($('followCamera')?.checked);
      const markerMode = cameraFacing ? 'viewport' : 'map';
      const el = createMarkerEl(getCurrentMoverType(), size);
      temp.animatedMarkerEl = el;
      temp.animatedMarker = new maplibregl.Marker({element:el, anchor:'center', rotationAlignment:markerMode, pitchAlignment:markerMode})
        .setLngLat(point).addTo(exportMap);
      const displayAngle = cameraFacing ? (getFixedAngle(getCurrentAnimationIconType()) + getManualAnimAngle()) : finalAngle(progress);
      temp.animatedMarker.setRotation(displayAngle);
      temp.markerCameraMode = markerMode;
    }
  }
  return temp;
}

function removeNativeExportMarkers(temp){
  try{ temp.markerA?.remove?.(); }catch(e){}
  try{ temp.markerB?.remove?.(); }catch(e){}
  (temp.manualViaMarkers || []).forEach(m => { try{ m.remove(); }catch(e){} });
  (temp.sceneIcons || []).forEach(item => { try{ item.marker?.remove?.(); }catch(e){} });
  (temp.mapLabels || []).forEach(item => { try{ item.marker?.remove?.(); }catch(e){} });
  try{ temp.animatedMarker?.remove?.(); }catch(e){}
}

function getWebglMaxTextureSize(){
  if(state._exportMaxTextureSize) return state._exportMaxTextureSize;
  let maxSize = 4096;
  try{
    const c = document.createElement('canvas');
    const gl = c.getContext('webgl') || c.getContext('experimental-webgl');
    if(gl) maxSize = Number(gl.getParameter(gl.MAX_TEXTURE_SIZE)) || maxSize;
  }catch(e){}
  state._exportMaxTextureSize = Math.max(2048, maxSize);
  return state._exportMaxTextureSize;
}

function getNativeExportChunkSize(){
  const maxTex = getWebglMaxTextureSize();
  // držíme se nízko, aby Chrome/WebGL nezačal 8K potichu renderovat jako rozmazaný buffer
  return Math.max(1024, Math.min(2048, maxTex - 512));
}

function shouldUseChunkedNativeExport(outW, outH){
  const maxTex = getWebglMaxTextureSize();
  return outW > Math.min(4096, maxTex - 256) || outH > Math.min(4096, maxTex - 256) || (outW * outH) > (3840 * 2160);
}

async function drawNativeMapFrameChunked(targetCanvas, camera, capturedGhost, capturedAnim, capturedHiddenLayers=[]){
  if(!state.map || typeof maplibregl === 'undefined') return false;
  const {w:outW, h:outH} = getExportSize();
  const chunkSize = getNativeExportChunkSize();
  const bleed = Math.max(48, Math.min(160, Math.round(chunkSize * 0.07)));

  targetCanvas.width = outW;
  targetCanvas.height = outH;
  const finalCtx = targetCanvas.getContext('2d');
  finalCtx.clearRect(0, 0, outW, outH);

  const container = document.createElement('div');
  container.setAttribute('aria-hidden', 'true');
  container.style.cssText = `position:fixed;left:-10000px;top:0;width:256px;height:256px;overflow:hidden;pointer-events:none;opacity:.01;z-index:0;background:#fff;`;
  document.body.appendChild(container);

  let exportMap = null;
  let tempMarkers = null;
  const frame = $('exportFrame');
  const frameWasHidden = !!frame?.classList.contains('hidden');
  const saved = {
    map:state.map,
    markerA:state.markerA,
    markerB:state.markerB,
    manualViaMarkers:state.manualViaMarkers,
    sceneIcons:state.sceneIcons,
    mapLabels:state.mapLabels,
    animatedMarker:state.animatedMarker,
    animatedMarkerEl:state.animatedMarkerEl,
    markerCameraMode:state.markerCameraMode,
    originalRoadWidthPaints:state.originalRoadWidthPaints,
    originalBoundaryWidthPaints:state.originalBoundaryWidthPaints,
    exportCropOverride:state.exportCropOverride
  };

  try{
    const firstW = Math.min(chunkSize, outW) + bleed * 2;
    const firstH = Math.min(chunkSize, outH) + bleed * 2;
    container.style.width = firstW + 'px';
    container.style.height = firstH + 'px';

    exportMap = new maplibregl.Map({
      container,
      style: cloneExportStyle(),
      center: camera.center,
      zoom: camera.zoom,
      pitch: camera.pitch,
      bearing: camera.bearing,
      interactive:false,
      attributionControl:false,
      preserveDrawingBuffer:true,
      fadeDuration:0,
      pixelRatio: 1
    });
    try{ exportMap.setPixelRatio?.(1); }catch(e){}

    state.map = exportMap;
    state.originalRoadWidthPaints = {};
    state.originalBoundaryWidthPaints = {};

    setStatus(t('Připravuji nativní 8K/4K export po dlaždicích…'));
    await waitExportMapReady(exportMap, Math.min(10000, getExportDetailWaitMs()));

    ensureRouteSources();
    rememberOriginalRoadPaints();
    try{ await ensureGeoDataLoaded(); }catch(e){}
    ensurePoliticalLayers();
    ensureLibertyHillshadeOverlay();
    applyPreferredMapLabelLanguage();
    applyMapTweaks();
    enforceRoadShieldToggle();
    applyHiddenStyleLayerIds(capturedHiddenLayers);
    applyCapturedRouteSources(capturedGhost, capturedAnim);

    tempMarkers = createNativeExportMarkers(exportMap);
    state.markerA = tempMarkers.markerA;
    state.markerB = tempMarkers.markerB;
    state.manualViaMarkers = tempMarkers.manualViaMarkers;
    state.sceneIcons = tempMarkers.sceneIcons;
    state.mapLabels = tempMarkers.mapLabels;
    state.animatedMarker = tempMarkers.animatedMarker;
    state.animatedMarkerEl = tempMarkers.animatedMarkerEl;
    state.markerCameraMode = tempMarkers.markerCameraMode;

    if(frame) frame.classList.add('hidden');

    const totalCols = Math.ceil(outW / chunkSize);
    const totalRows = Math.ceil(outH / chunkSize);
    const total = totalCols * totalRows;
    let index = 0;

    for(let y = 0; y < outH; y += chunkSize){
      const ch = Math.min(chunkSize, outH - y);
      for(let x = 0; x < outW; x += chunkSize){
        const cw = Math.min(chunkSize, outW - x);
        const renderW = cw + bleed * 2;
        const renderH = ch + bleed * 2;
        container.style.width = renderW + 'px';
        container.style.height = renderH + 'px';
        try{ exportMap.resize(); }catch(e){}

        // Nejprve mapa na hlavní centrum exportu. Z něj spočítáme centrum aktuálního výřezu.
        try{ exportMap.jumpTo({center:camera.center, zoom:camera.zoom, pitch:camera.pitch, bearing:camera.bearing}); }catch(e){}
        try{ exportMap.resize(); exportMap.triggerRepaint(); }catch(e){}
        const offsetX = x + cw / 2 - outW / 2;
        const offsetY = y + ch / 2 - outH / 2;
        let chunkCenter = null;
        try{ chunkCenter = exportMap.unproject([renderW / 2 + offsetX, renderH / 2 + offsetY]); }catch(e){}
        if(chunkCenter){
          try{ exportMap.jumpTo({center:[chunkCenter.lng, chunkCenter.lat], zoom:camera.zoom, pitch:camera.pitch, bearing:camera.bearing}); }catch(e){}
        }

        index += 1;
        setStatus(`${t('Exportuji PNG v nativním detailu')} ${index}/${total}…`);
        await waitExportMapReady(exportMap, Math.min(9000, getExportDetailWaitMs()));
        enforceRoadShieldToggle();
        applyHiddenStyleLayerIds(capturedHiddenLayers);

        const chunkCanvas = document.createElement('canvas');
        const prevOverride = state.exportCropOverride;
        state.exportCropOverride = () => {
          const mapCanvas = exportMap.getCanvas();
          const rect = mapCanvas.getBoundingClientRect();
          const sx = mapCanvas.width / Math.max(1, rect.width);
          const sy = mapCanvas.height / Math.max(1, rect.height);
          return {
            source: mapCanvas,
            x: bleed * sx,
            y: bleed * sy,
            w: cw * sx,
            h: ch * sy,
            outW: cw,
            outH: ch
          };
        };
        const ok = await drawBrowserMapFrame(chunkCanvas);
        state.exportCropOverride = prevOverride;
        if(!ok) throw new Error('Chunk render failed');
        finalCtx.drawImage(chunkCanvas, 0, 0, cw, ch, x, y, cw, ch);
        await new Promise(resolve => requestAnimationFrame(resolve));
      }
    }

    return true;
  }catch(err){
    console.warn('Chunked native export failed', err);
    setStatus(t('Nativní dlaždicový export selhal, používám nouzový export z prohlížeče.'));
    return false;
  }finally{
    if(frame && !frameWasHidden) frame.classList.remove('hidden');
    state.map = saved.map;
    state.markerA = saved.markerA;
    state.markerB = saved.markerB;
    state.manualViaMarkers = saved.manualViaMarkers;
    state.sceneIcons = saved.sceneIcons;
    state.mapLabels = saved.mapLabels;
    state.animatedMarker = saved.animatedMarker;
    state.animatedMarkerEl = saved.animatedMarkerEl;
    state.markerCameraMode = saved.markerCameraMode;
    state.originalRoadWidthPaints = saved.originalRoadWidthPaints;
    state.originalBoundaryWidthPaints = saved.originalBoundaryWidthPaints;
    state.exportCropOverride = saved.exportCropOverride;
    if(tempMarkers) removeNativeExportMarkers(tempMarkers);
    try{ exportMap?.remove?.(); }catch(e){}
    try{ container.remove(); }catch(e){}
  }
}

async function drawNativeMapFrame(targetCanvas){
  if(!state.map || typeof maplibregl === 'undefined') return false;
  const {w:outW, h:outH} = getExportSize();
  const camera = makeExportCameraFromFrame(outW, outH);
  if(!camera) return false;

  const baseMap = state.map;
  const capturedGhost = getLiveSourceDataFromMap(baseMap, 'route-ghost');
  const capturedAnim = getLiveSourceDataFromMap(baseMap, 'route-anim');
  const capturedHiddenLayers = getHiddenStyleLayerIds(baseMap);
  if(shouldUseChunkedNativeExport(outW, outH)){
    return await drawNativeMapFrameChunked(targetCanvas, camera, capturedGhost, capturedAnim, capturedHiddenLayers);
  }
  const container = document.createElement('div');
  container.setAttribute('aria-hidden', 'true');
  container.style.cssText = `position:fixed;left:-10000px;top:0;width:${camera.cssW}px;height:${camera.cssH}px;overflow:hidden;pointer-events:none;opacity:.01;z-index:0;background:#fff;`;
  document.body.appendChild(container);

  let exportMap = null;
  let tempMarkers = null;
  const frame = $('exportFrame');
  const frameWasHidden = !!frame?.classList.contains('hidden');
  const saved = {
    map:state.map,
    markerA:state.markerA,
    markerB:state.markerB,
    manualViaMarkers:state.manualViaMarkers,
    sceneIcons:state.sceneIcons,
    mapLabels:state.mapLabels,
    animatedMarker:state.animatedMarker,
    animatedMarkerEl:state.animatedMarkerEl,
    markerCameraMode:state.markerCameraMode,
    originalRoadWidthPaints:state.originalRoadWidthPaints,
    originalBoundaryWidthPaints:state.originalBoundaryWidthPaints
  };

  try{
    exportMap = new maplibregl.Map({
      container,
      style: cloneExportStyle(),
      center: camera.center,
      zoom: camera.zoom,
      pitch: camera.pitch,
      bearing: camera.bearing,
      interactive:false,
      attributionControl:false,
      preserveDrawingBuffer:true,
      fadeDuration:0,
      pixelRatio: camera.pixelRatio
    });
    try{ exportMap.setPixelRatio?.(camera.pixelRatio); }catch(e){}
    setStatus(t('Načítám nativní detail exportu…'));
    await waitExportMapReady(exportMap);

    state.map = exportMap;
    state.originalRoadWidthPaints = {};
    state.originalBoundaryWidthPaints = {};
    ensureRouteSources();
    rememberOriginalRoadPaints();
    try{ await ensureGeoDataLoaded(); }catch(e){}
    ensurePoliticalLayers();
    ensureLibertyHillshadeOverlay();
    applyPreferredMapLabelLanguage();
    setTimeout(() => { try{ if(state.map === exportMap) applyPreferredMapLabelLanguage(); }catch(e){} }, 0);
    applyMapTweaks();
    enforceRoadShieldToggle();
    applyHiddenStyleLayerIds(capturedHiddenLayers);
    applyCapturedRouteSources(capturedGhost, capturedAnim);
    try{ exportMap.jumpTo({center:camera.center, zoom:camera.zoom, pitch:camera.pitch, bearing:camera.bearing}); }catch(e){}
    try{ exportMap.resize(); exportMap.triggerRepaint(); }catch(e){}
    await waitExportMapReady(exportMap);

    tempMarkers = createNativeExportMarkers(exportMap);
    state.markerA = tempMarkers.markerA;
    state.markerB = tempMarkers.markerB;
    state.manualViaMarkers = tempMarkers.manualViaMarkers;
    state.sceneIcons = tempMarkers.sceneIcons;
    state.mapLabels = tempMarkers.mapLabels;
    state.animatedMarker = tempMarkers.animatedMarker;
    state.animatedMarkerEl = tempMarkers.animatedMarkerEl;
    state.markerCameraMode = tempMarkers.markerCameraMode;

    if(frame) frame.classList.add('hidden');
    await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
    const ok = await drawBrowserMapFrame(targetCanvas);
    if(ok && targetCanvas.width === outW && targetCanvas.height === outH) return true;
    return !!ok;
  }catch(err){
    console.warn('Native high-detail export failed, falling back to browser crop.', err);
    setStatus(t('Nativní detail exportu selhal, používám nouzový export z prohlížeče.'));
    return false;
  }finally{
    if(frame && !frameWasHidden) frame.classList.remove('hidden');
    state.map = saved.map;
    state.markerA = saved.markerA;
    state.markerB = saved.markerB;
    state.manualViaMarkers = saved.manualViaMarkers;
    state.sceneIcons = saved.sceneIcons;
    state.mapLabels = saved.mapLabels;
    state.animatedMarker = saved.animatedMarker;
    state.animatedMarkerEl = saved.animatedMarkerEl;
    state.markerCameraMode = saved.markerCameraMode;
    state.originalRoadWidthPaints = saved.originalRoadWidthPaints;
    state.originalBoundaryWidthPaints = saved.originalBoundaryWidthPaints;
    if(tempMarkers) removeNativeExportMarkers(tempMarkers);
    try{ exportMap?.remove?.(); }catch(e){}
    try{ container.remove(); }catch(e){}
  }
}

async function drawCurrentMapFrame(targetCanvas){
  const nativeOk = await drawNativeMapFrame(targetCanvas);
  if(nativeOk) return true;
  return drawBrowserMapFrame(targetCanvas);
}

async function drawBrowserMapFrame(targetCanvas){
  const crop = getExportCrop();
  if(!crop) return false;
  targetCanvas.width = crop.outW;
  targetCanvas.height = crop.outH;
  const ctx = targetCanvas.getContext('2d');
  ctx.clearRect(0,0,targetCanvas.width,targetCanvas.height);
  ctx.drawImage(crop.source, crop.x, crop.y, crop.w, crop.h, 0, 0, crop.outW, crop.outH);

  const mapCanvas = crop.source;
  const mapRect = mapCanvas.getBoundingClientRect();
  const scaleX = mapCanvas.width / Math.max(1, mapRect.width);
  const scaleY = mapCanvas.height / Math.max(1, mapRect.height);
  const outScaleX = crop.outW / crop.w;
  const outScaleY = crop.outH / crop.h;

  async function drawElement(el, isAnimMarker){
    if(!el) return;
    const rect = el.getBoundingClientRect();
    const x = (rect.left - mapRect.left) * scaleX;
    const y = (rect.top - mapRect.top) * scaleY;
    const w = rect.width * scaleX;
    const h = rect.height * scaleY;
    const dx = (x - crop.x) * outScaleX;
    const dy = (y - crop.y) * outScaleY;
    const dw = w * outScaleX;
    const dh = h * outScaleY;
    if(dx + dw < 0 || dy + dh < 0 || dx > crop.outW || dy > crop.outH) return;

    // Extract rotation for animated marker
    let rotation = 0;
    if(isAnimMarker && state.animatedMarker){
      try { rotation = state.animatedMarker.getRotation() || 0; } catch(e){}
    }

    if (el.classList && el.classList.contains('route-dot')) {
      const text = el.textContent;
      const isA = el.classList.contains('dot-a');
      const isB = el.classList.contains('dot-b');
      const isWp = el.classList.contains('dot-wp');

      ctx.save();
      const radius = (isWp ? 11 : 14) * outScaleX;
      const colorHex = isA ? '#e63946' : isB ? '#4da6ff' : '#e6b422';
      const fontSize = (isWp ? 10 : 12) * outScaleX;
      const borderW = (isWp ? 1.5 : 2) * outScaleX;

      ctx.translate(dx + dw/2, dy + dh/2);

      // Stín
      ctx.shadowColor = 'rgba(0,0,0,0.4)';
      ctx.shadowBlur = 8 * outScaleX;
      ctx.shadowOffsetY = 2 * outScaleX;

      // Kruh
      ctx.beginPath();
      ctx.arc(0, 0, radius, 0, Math.PI*2);
      ctx.fillStyle = colorHex;
      ctx.fill();

      // Okraj (bez stínu)
      ctx.shadowColor = 'transparent';
      ctx.lineWidth = borderW;
      ctx.strokeStyle = '#fff';
      ctx.stroke();

      // Text
      ctx.fillStyle = isWp ? '#000' : '#fff';
      ctx.font = `700 ${fontSize}px sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, 0, 1 * outScaleX);
      ctx.restore();
      return;
    }


    // Export custom text labels (mapLabels). These labels are plain HTML,
    // not SVG/IMG, so they must be painted manually onto the export canvas.
    if (el.classList && el.classList.contains('map-label-marker')) {
      const bubble = el.querySelector('.map-label-bubble');
      const square = el.querySelector('.map-label-square');
      const domScaleX = scaleX * outScaleX;
      const domScaleY = scaleY * outScaleY;
      const avgScale = Math.max(0.1, (domScaleX + domScaleY) / 2);

      const toExportRect = (domRect) => ({
        x: (((domRect.left - mapRect.left) * scaleX) - crop.x) * outScaleX,
        y: (((domRect.top - mapRect.top) * scaleY) - crop.y) * outScaleY,
        w: domRect.width * domScaleX,
        h: domRect.height * domScaleY
      });

      const pathRoundRect = (x, y, w, h, r) => {
        const rr = Math.max(0, Math.min(r || 0, w / 2, h / 2));
        ctx.beginPath();
        ctx.moveTo(x + rr, y);
        ctx.lineTo(x + w - rr, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + rr);
        ctx.lineTo(x + w, y + h - rr);
        ctx.quadraticCurveTo(x + w, y + h, x + w - rr, y + h);
        ctx.lineTo(x + rr, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - rr);
        ctx.lineTo(x, y + rr);
        ctx.quadraticCurveTo(x, y, x + rr, y);
        ctx.closePath();
      };

      ctx.save();

      if(bubble){
        const b = toExportRect(bubble.getBoundingClientRect());
        const bs = window.getComputedStyle(bubble);
        const borderW = (parseFloat(bs.borderLeftWidth) || 0) * avgScale;
        const radius = (parseFloat(bs.borderRadius) || 3) * avgScale;
        const padLeft = (parseFloat(bs.paddingLeft) || 0) * domScaleX;
        const padRight = (parseFloat(bs.paddingRight) || 0) * domScaleX;
        const fontSize = Math.max(8, (parseFloat(bs.fontSize) || 28) * avgScale);
        const text = bubble.textContent || '';

        ctx.shadowColor = 'rgba(0,0,0,0.18)';
        ctx.shadowBlur = 10 * avgScale;
        ctx.shadowOffsetY = 2 * avgScale;
        pathRoundRect(b.x, b.y, b.w, b.h, radius);
        ctx.fillStyle = bs.backgroundColor || 'rgba(255,255,255,.98)';
        ctx.fill();

        ctx.shadowColor = 'transparent';
        if(borderW > 0){
          pathRoundRect(b.x + borderW/2, b.y + borderW/2, b.w - borderW, b.h - borderW, Math.max(0, radius - borderW/2));
          ctx.lineWidth = borderW;
          ctx.strokeStyle = bs.borderLeftColor || 'rgba(0,0,0,.08)';
          ctx.stroke();
        }

        ctx.fillStyle = bs.color || '#111';
        ctx.font = `${bs.fontWeight || 800} ${fontSize}px ${bs.fontFamily || 'sans-serif'}`;
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        ctx.fillText(text, b.x + padLeft, b.y + b.h / 2, Math.max(1, b.w - padLeft - padRight));
      }

      if(square){
        const s = toExportRect(square.getBoundingClientRect());
        const ss = window.getComputedStyle(square);
        ctx.shadowColor = 'rgba(0,0,0,0.20)';
        ctx.shadowBlur = 6 * avgScale;
        ctx.shadowOffsetY = 1 * avgScale;
        ctx.fillStyle = ss.backgroundColor || '#ff1434';
        ctx.fillRect(s.x, s.y, s.w, s.h);
      }

      ctx.restore();
      return;
    }

    const svg = el.querySelector('svg');
    if(svg){
      const xml = new XMLSerializer().serializeToString(svg);
      const img = new Image();
      await new Promise(resolve => { img.onload = resolve; img.onerror = resolve; img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(xml); });
      if(img.complete){
        if(rotation){
          ctx.save();
          ctx.translate(dx + dw/2, dy + dh/2);
          ctx.rotate(rotation * Math.PI / 180);
          ctx.drawImage(img, -dw/2, -dh/2, dw, dh);
          ctx.restore();
        } else {
          ctx.drawImage(img, dx, dy, dw, dh);
        }
      }
      return;
    }
    // Fallback: draw img elements (scene icons)
    const imgEl = el.querySelector('img') || (el.tagName === 'IMG' ? el : null);
    if(imgEl && imgEl.complete && imgEl.naturalWidth > 0){
      ctx.save();
      if(rotation){
        ctx.translate(dx + dw/2, dy + dh/2);
        ctx.rotate(rotation * Math.PI / 180);
        ctx.drawImage(imgEl, -dw/2, -dh/2, dw, dh);
      } else {
        ctx.drawImage(imgEl, dx, dy, dw, dh);
      }
      ctx.restore();
    }
  }

  await drawElement(state.markerA?.getElement?.(), false);
  await drawElement(state.markerB?.getElement?.(), false);
  for(const m of state.manualViaMarkers){ await drawElement(m.getElement?.(), false); }
  for(const item of state.sceneIcons){ await drawElement((item.marker || item).getElement?.(), false); }
  for(const item of state.mapLabels){ await drawElement(item.marker?.getElement?.(), false); }
  await drawElement(state.animatedMarkerEl, true);
  return true;
}

function wait(ms){ return new Promise(resolve => setTimeout(resolve, ms)); }

function waitMapRender(maxWaitMs = 48){
  return new Promise(resolve => {
    if(!state.map){ resolve(); return; }
    let done = false;
    const finish = () => {
      if(done) return;
      done = true;
      try{ state.map.off('render', onRender); }catch(e){}
      resolve();
    };
    const onRender = () => {
      requestAnimationFrame(finish);
    };
    try{
      state.map.on('render', onRender);
      state.map.triggerRepaint();
    }catch(e){
      requestAnimationFrame(finish);
      return;
    }
    requestAnimationFrame(() => requestAnimationFrame(finish));
    setTimeout(finish, Math.max(12, maxWaitMs || 0));
  });
}

