function applyMapTweaks(){
  if(!state.map?.isStyleLoaded()) return;
  const land = $('landColor')?.value || PRESETS.reset.land;
  const water = $('waterColor')?.value || PRESETS.reset.water;
  const building = $('buildingColor')?.value || PRESETS.reset.building;
  const park = $('parkColor')?.value || PRESETS.reset.park;
  const landcover = $('landcoverColor')?.value || PRESETS.reset.landcover;
  const landuse = $('landuseColor')?.value || PRESETS.reset.landuse;
  const aeroway = $('aerowayColor')?.value || PRESETS.reset.aeroway;
  const roadMajor = $('roadMajorColor')?.value || PRESETS.reset.roadMajor;
  const roadMinor = $('roadMinorColor')?.value || PRESETS.reset.roadMinor;
  const label = $('labelColor')?.value || PRESETS.reset.label;
  const halo = $('haloColor')?.value || PRESETS.reset.halo;
  const majorWidth = parseFloat($('majorWidth')?.value || '1.3');
  const minorWidth = parseFloat($('minorWidth')?.value || '1.0');
  const buildingOpacity = parseFloat($('buildingOpacity')?.value || '0.72');
  const boundaryOpacity = parseFloat($('boundaryOpacity')?.value || '1');
  const boundaryWidth = parseFloat($('boundaryWidth')?.value || '1.2');
  const boundaryColor = ($('boundaryColor')?.value || '#6f7378');

  applyColorToLayers(matchLayers(/background/, 'background'), 'background-color', land);
  applyColorToLayers(matchLayers(/water/, 'fill'), 'fill-color', water);
  applyColorToLayers(matchLayers(/water/, 'line'), 'line-color', water);
  applyColorToLayers(matchLayers(/park|green|wood|forest|grass/, 'fill'), 'fill-color', park);
  applyColorToLayers(matchLayers(/landcover/, 'fill'), 'fill-color', landcover);
  applyColorToLayers(matchLayers(/landuse/, 'fill'), 'fill-color', landuse);
  applyColorToLayers(matchLayers(/aeroway/, 'fill'), 'fill-color', aeroway);
  applyColorToLayers(matchLayers(/building/, 'fill'), 'fill-color', building);
  applyColorToLayers(matchLayers(/building/, 'fill-extrusion'), 'fill-extrusion-color', building);
  matchLayers(/building/, 'fill').forEach(l => safeSetPaint(l.id, 'fill-opacity', buildingOpacity));
  matchLayers(/building/, 'fill-extrusion').forEach(l => safeSetPaint(l.id, 'fill-extrusion-opacity', buildingOpacity));
  const controlledBoundaries = getControlledBoundaryLayers();
  applyColorToLayers(controlledBoundaries.target, 'line-color', boundaryColor);
  controlledBoundaries.target.forEach(l => {
    safeSetPaint(l.id, 'line-opacity', boundaryOpacity);
    const baseW = state.originalBoundaryWidthPaints[l.id];
    const widthExpr = baseW == null ? (0.6 * boundaryWidth) : scalePaintWidthExpression(baseW, boundaryWidth);
    try{ state.map.setPaintProperty(l.id, 'line-width', widthExpr); }catch(e){}
  });

  matchLayers(/road|street|highway|motorway|trunk|primary/, 'line').forEach(l => {
    const id = (l.id||'').toLowerCase();
    const isMajor = /motorway|trunk|primary|major/.test(id);
    safeSetPaint(l.id, 'line-color', isMajor ? roadMajor : roadMinor);
    const baseWidth = state.originalRoadWidthPaints[l.id];
    const widthExpr = baseWidth == null ? (isMajor ? 1.4 * majorWidth : 1.0 * minorWidth) : scalePaintWidthExpression(baseWidth, isMajor ? majorWidth : minorWidth);
    try{ state.map.setPaintProperty(l.id, 'line-width', widthExpr); }catch(e){}
  });

  const labelLayers = matchLayers(/label|place|name|poi|airport|aerodrome/, 'symbol');
  labelLayers.forEach(l => {
    safeSetPaint(l.id, 'text-color', label);
    safeSetPaint(l.id, 'text-halo-color', halo);
    safeSetPaint(l.id, 'text-halo-width', 1.2);
  });

  setVisibilityByRegex(/building/, $('showBuildings')?.checked !== false, ['fill','fill-extrusion','line']);
  setVisibilityByRegex(/park|green|wood|forest|grass/, $('showParks')?.checked !== false, ['fill','line']);
  setVisibilityByRegex(/landcover/, $('showLandcover')?.checked !== false, ['fill']);
  setVisibilityByRegex(/landuse/, $('showLanduse')?.checked !== false, ['fill']);
  // Letiště se ve stylech MapLibre neobjevuje jen jako plocha `aeroway`,
  // ale často také jako symbol/POI vrstva s id obsahujícím `airport`,
  // `aerodrome`, `runway` nebo `taxiway`. Původně se proto vypnuly
  // jen letištní plochy, ale zůstal název a ikonka letiště.
  setVisibilityByRegex(/aeroway|aerodrome|airport|runway|taxiway/, $('showAeroway')?.checked !== false, ['fill','line','symbol']);
  applyControlledBoundaryVisibility($('showBoundaries')?.checked !== false);
  setVisibilityByRegex(/label|place|name|poi|airport|aerodrome/, $('showLabels')?.checked !== false, ['symbol']);
  setRoadShieldVisibility($('showRoadShields')?.checked !== false && $('showLabels')?.checked !== false);
  enforceRoadShieldToggle();
  setVisibilityByRegex(/road|street|minor/, $('showMinorRoads')?.checked !== false, ['line']);
  setVisibilityByRegex(/motorway|trunk|primary|major/, $('showMajorRoads')?.checked !== false, ['line']);

  if(state.countriesGeojson || state.countryBorderLinesGeojson || state.czRegionsGeojson){
    ensurePoliticalLayers();
    const borderVisible = !!$('showCountryBordersOverlay')?.checked;
    const borderMode = $('countryBorderMode')?.value || 'all';
    const borderColor = ($('countryBorderColor')?.value || '#ffffff');
    const borderWidth = parseFloat($('countryBorderWidth')?.value || '1.0');
    const borderOpacity = parseFloat($('countryBorderOpacity')?.value || '1');
    const selectedCountryId = $('countryFocusSelect')?.value || $('politicalCountrySelect')?.value || '';
    const showPoliticalCountries = !!$('showPoliticalCountries')?.checked || (($('baseStyle')?.value || '') === 'political');
    const showCzRegions = !!$('showCzRegions')?.checked;
    const czechIds = getCzechCountryIds();
    const excludeCzechFilter = buildExcludeCountryFilter(czechIds);
    const showStandaloneCountryBorders = borderVisible && borderMode === 'all' && !showCzRegions && !showPoliticalCountries;
    const showSelectedCountryBorder = borderVisible && borderMode === 'selected' && selectedCountryId && !(showCzRegions && isCzechCountryId(selectedCountryId));
    const showPoliticalOutline = showPoliticalCountries && !showCzRegions;
    safeSetPaint('pz-country-borders-all', 'line-color', borderColor);
