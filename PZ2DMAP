function startMapLabelInlineEdit(id){
  const item = getMapLabelById(id);
  const el = item?.marker?.getElement?.();
  const bubble = el?.querySelector?.('.map-label-bubble');
  if(!item || !bubble || bubble.isContentEditable) return;
  selectMapLabel(id, false);
  const oldText = item.text || 'Popisek';
  bubble.textContent = oldText;
  bubble.contentEditable = 'true';
  bubble.spellcheck = false;
  bubble.classList.add('editing');
  bubble.setAttribute('role', 'textbox');
  bubble.setAttribute('aria-label', 'Text popisku');
  let done = false;
  const stop = ev => ev.stopPropagation();
  const finish = save => {
    if(done) return;
    done = true;
    bubble.removeEventListener('mousedown', stop);
    bubble.removeEventListener('click', stop);
    bubble.removeEventListener('dblclick', stop);
    bubble.removeEventListener('paste', stop);
    bubble.contentEditable = 'false';
    bubble.classList.remove('editing');
    bubble.removeAttribute('role');
    bubble.removeAttribute('aria-label');
    const text = save ? (bubble.textContent || '').replace(/\s+/g, ' ').trim() || 'Popisek' : oldText;
    updateMapLabel(id, {text});
    if($('mapLabelText')) $('mapLabelText').value = text;
    setStatus(save ? t('Popisek upraven.') : t('Úprava popisku zrušena.'));
  };
  bubble.addEventListener('mousedown', stop);
  bubble.addEventListener('click', stop);
  bubble.addEventListener('dblclick', stop);
  bubble.addEventListener('paste', stop);
  bubble.addEventListener('keydown', ev => {
    ev.stopPropagation();
    if(ev.key === 'Enter'){
      ev.preventDefault();
      finish(true);
      bubble.blur();
    }else if(ev.key === 'Escape'){
      ev.preventDefault();
      finish(false);
      bubble.blur();
    }
  });
  bubble.addEventListener('blur', () => finish(true), {once:true});
  requestAnimationFrame(()=>{
    bubble.focus();
    const selection = window.getSelection?.();
    if(!selection) return;
    const range = document.createRange();
    range.selectNodeContents(bubble);
    selection.removeAllRanges();
    selection.addRange(range);
  });
}

