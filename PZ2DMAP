    if(!state.map.getLayer('pz-country-borders-all')) state.map.addLayer({
      id:'pz-country-borders-all', type:'line', source:'pz-country-borders-lines',
      layout:{'line-join':'round','line-cap':'round'},
      paint:{'line-color':'#ffffff','line-width':2.0,'line-opacity':0}
    }, beforeId);
  } else if(state.countriesGeojson){
    if(!state.map.getLayer('pz-country-borders-all')) state.map.addLayer({
      id:'pz-country-borders-all', type:'line', source:'pz-countries',
      layout:{'line-join':'round','line-cap':'round'},
      paint:{'line-color':'#ffffff','line-width':2.0,'line-opacity':0}
    }, beforeId);
  }

  if(state.czRegionsGeojson){
    if(!state.map.getSource('pz-cz-regions')) state.map.addSource('pz-cz-regions', {type:'geojson', data: state.czRegionsGeojson});
    else state.map.getSource('pz-cz-regions').setData(state.czRegionsGeojson);

    if(!state.map.getLayer('pz-cz-regions-fill')) state.map.addLayer({
      id:'pz-cz-regions-fill', type:'fill', source:'pz-cz-regions',
      layout:{'fill-sort-key':['get','__drawPriority']},
      paint:{'fill-color':'#d7dbe2','fill-opacity':0}
    }, beforeId);

    if(!state.map.getLayer('pz-cz-regions-outline')) state.map.addLayer({
      id:'pz-cz-regions-outline', type:'line', source:'pz-cz-regions',
      layout:{'line-sort-key':['get','__drawPriority']},
      paint:{'line-color':'#ffffff','line-width':2.0,'line-opacity':0}
    }, beforeId);
  }

  // Apply correct opacity immediately after layers exist — no dependency on applyMapTweaks timing
  const showPolCountries = !!$('showPoliticalCountries')?.checked || (($('baseStyle')?.value || '') === 'political');
  const polFillOpacity = parseFloat($('politicalFillOpacity')?.value || '0.92');
  const showCzReg = !!$('showCzRegions')?.checked;
  const czFillOpacity = parseFloat($('czRegionFillOpacity')?.value || '0.82');
  const bordersOn = !!$('showCountryBordersOverlay')?.checked;
  const bOpacity = parseFloat($('countryBorderOpacity')?.value || '1');
  const bMode = $('countryBorderMode')?.value || 'all';
  const selCountryId = $('countryFocusSelect')?.value || $('politicalCountrySelect')?.value || '';
  const czechIds = getCzechCountryIds();
  const excludeCzechFilter = buildExcludeCountryFilter(czechIds);
  const showStandaloneCountryBorders = bordersOn && bMode === 'all' && !showCzReg && !showPolCountries;
  const showSelectedCountryBorder = bordersOn && bMode === 'selected' && selCountryId && !(showCzReg && isCzechCountryId(selCountryId));
  const showPoliticalOutline = showPolCountries && !showCzReg;
  safeSetPaint('pz-political-fill', 'fill-opacity', showPolCountries ? polFillOpacity : 0);
  safeSetFilter('pz-political-outline', showCzReg && excludeCzechFilter ? excludeCzechFilter : null);
  safeSetPaint('pz-political-outline', 'line-opacity', showPoliticalOutline ? Math.max(0.45, bOpacity * 0.8) : 0);
  safeSetPaint('pz-country-borders-all', 'line-opacity', showStandaloneCountryBorders ? bOpacity : 0);
  safeSetPaint('pz-country-borders-selected', 'line-opacity', showSelectedCountryBorder ? Math.min(1, bOpacity + 0.15) : 0);
  safeSetPaint('pz-cz-regions-fill', 'fill-opacity', showCzReg ? czFillOpacity : 0);
  safeSetPaint('pz-cz-regions-outline', 'line-opacity', showCzReg ? 0.92 : 0);
}

