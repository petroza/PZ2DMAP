async function getPointFromInputOrState(inputId, currentPoint){
  const raw = $(inputId)?.value?.trim() || '';
  // If we already have a point from map click or autocomplete selection,
  // trust it. The input text is just a human-friendly label — re-geocoding
  // a truncated display name can easily fail or pick the wrong place.
  if(currentPoint) return {point: currentPoint, label: raw || `${currentPoint[1].toFixed(5)}, ${currentPoint[0].toFixed(5)}`};
  if(raw){
    const parsed = parseLatLng(raw);
    if(parsed){
      return {point: parsed, label: `${parsed[1].toFixed(5)}, ${parsed[0].toFixed(5)}`};
    }
    const item = await geocode(raw);
    return {point: placePointFromItem(item), label: normalizePlaceLabel(item) || raw, item};
  }
  throw new Error('Chybí bod ' + inputId);
}

function restoreAnimationState(elapsed, wasPlaying){
  const total = animationTotal();
  state.animElapsed = Math.max(0, Math.min(total, elapsed || 0));
  state.animPlaying = false;
  state.smoothAngle = null;
  const delay = parseFloat($('animStart')?.value || '0');
  const dur = Math.max(0.001, parseFloat($('animDuration')?.value || '8'));
  const progress = state.animElapsed <= delay ? 0 : Math.min(1, (state.animElapsed - delay) / dur);
  redrawRoute();
  if(state.routeCoords.length && progress > 0 && $('animDot')?.checked) setAnimProgress(progress);
  else if(!state.routeCoords.length || progress <= 0) removeAnimMarker();
  updateReadouts();
  if(wasPlaying) playAnimation();
}

