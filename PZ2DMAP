function getSelectedMapObject(){
  if(state.selectedRoutePointType){
    return {type:'routePoint', id:state.selectedRoutePointType, pointType:state.selectedRoutePointType};
  }
  if(state.selectedSceneIconId){
    const item = getSceneIconById(state.selectedSceneIconId);
    if(item) return {type:'sceneIcon', id:item.id, item};
  }
  if(state.selectedMapLabelId){
    const item = getMapLabelById(state.selectedMapLabelId);
    if(item) return {type:'mapLabel', id:item.id, item};
  }
  return null;
}

function copySelectedMapObject(){
  const selected = getSelectedMapObject();
  if(!selected){
    setStatus(t('Nejdřív klikem vyber objekt na mapě.'));
    return false;
  }
  if(selected.type === 'sceneIcon'){
    state.mapObjectClipboard = {
      type:'sceneIcon',
      data: selected.item.data,
      size: selected.item.size,
      lngLat: selected.item.lngLat.slice()
    };
    state.clipboardPasteCount = 0;
    setStatus(t('Ikonka zkopírována. Ctrl+V ji vloží jako kopii.'));
    return true;
  }
  if(selected.type === 'mapLabel'){
    state.mapObjectClipboard = {
      type:'mapLabel',
      text: selected.item.text,
      size: selected.item.size,
      side: selected.item.side,
      lngLat: selected.item.lngLat.slice()
    };
    state.clipboardPasteCount = 0;
    setStatus(t('Popisek zkopírován. Ctrl+V ho vloží jako kopii.'));
    return true;
  }
  return false;
}

function duplicateSelectedMapObject(){
  const selected = getSelectedMapObject();
  if(!selected){
    setStatus(t('Nejdřív klikem vyber objekt na mapě.'));
    return false;
  }
  if(selected.type === 'sceneIcon'){
    const lngLat = offsetLngLat(selected.item.lngLat, 30, 26);
    createSceneIconAt(lngLat, {data:selected.item.data, size:selected.item.size, silent:true});
    setStatus(t('Ikonka duplikována.'));
    return true;
  }
  if(selected.type === 'mapLabel'){
    const lngLat = offsetLngLat(selected.item.lngLat, 30, 26);
    addMapLabelAt(lngLat, {text:selected.item.text, size:selected.item.size, side:selected.item.side, silent:true});
    setStatus(t('Popisek duplikován.'));
    return true;
  }
  return false;
}

function pasteClipboardMapObject(){
  const clip = state.mapObjectClipboard;
  if(!clip){
    setStatus(t('Schránka je prázdná. Nejdřív dej Ctrl+C na vybraném objektu.'));
    return false;
  }
  state.clipboardPasteCount = (state.clipboardPasteCount || 0) + 1;
  const step = state.clipboardPasteCount;
  const lngLat = offsetLngLat(clip.lngLat, 26 * step, 22 * step);
  if(clip.type === 'sceneIcon'){
    createSceneIconAt(lngLat, {data:clip.data, size:clip.size, silent:true});
    setStatus(t('Ikonka vložena jako kopie.'));
    return true;
  }
  if(clip.type === 'mapLabel'){
    addMapLabelAt(lngLat, {text:clip.text, size:clip.size, side:clip.side, silent:true});
    setStatus(t('Popisek vložen jako kopie.'));
    return true;
  }
  return false;
}

function deleteSelectedMapObject(){
  const selected = getSelectedMapObject();
  if(!selected){
    setStatus(t('Nejdřív klikem vyber objekt na mapě.'));
    return false;
  }
  if(selected.type === 'routePoint'){
    return deleteRoutePoint(selected.pointType);
  }
  if(selected.type === 'sceneIcon'){
    deleteSceneIcon(selected.id);
    return true;
  }
  if(selected.type === 'mapLabel'){
    deleteMapLabel(selected.id);
    return true;
  }
  return false;
}

