// TN FIX: MapLibre normally locks vertical panning when the world is fully visible.
// That makes northern areas (Greenland / Arctic) impossible to place higher in the 16:9 export frame.
// This small patch relaxes only that viewport constraint and keeps the center latitude in safe WebMercator limits.
function unlockVerticalWorldPan(){
  const m = state.map;
  const tr = m?.transform;
  if(!tr || tr.__tnVerticalWorldPanUnlocked) return;
  const MAX_LAT = 85.0511287798066;
  const clampCenterLat = () => {
    try{
      const c = tr.center;
      if(!c || !Number.isFinite(c.lat)) return;
      const lat = Math.max(-MAX_LAT, Math.min(MAX_LAT, c.lat));
      if(lat !== c.lat){
        // LngLat is mutable in MapLibre. Mutating avoids triggering a recursive camera constraint.
        c.lat = lat;
        if(tr._center) tr._center.lat = lat;
      }
    }catch(e){}
  };
  ['_constrain','constrain'].forEach(name => {
    if(typeof tr[name] !== 'function') return;
    const original = tr[name].bind(tr);
    tr['__tnOriginal_' + name] = original;
    tr[name] = function(){ clampCenterLat(); return undefined; };
  });
  tr.__tnVerticalWorldPanUnlocked = true;
  m.on('moveend', clampCenterLat);
  m.on('zoomend', clampCenterLat);
  m.on('resize', clampCenterLat);
}

