}

function setAnimProgress(progress){
  // Camera animation runs independently — it works even without a route (news flyover/zoom).
  const cameraDriven = applyCameraAnimProgress(progress);
  if(!state.routeCoords.length){ updateReadouts(); return; }
  const sliced = sliceLineByProgress(state.routeCoords, progress);
  const point = sliced.point;
  const full = {type:'FeatureCollection',features:[{type:'Feature',geometry:{type:'LineString',coordinates:state.routeCoords},properties:{}}]};
  const partial = sliced.coords.length > 1 ? {type:'FeatureCollection',features:[{type:'Feature',geometry:{type:'LineString',coordinates:sliced.coords},properties:{}}]} : emptyFC();
  const ghostCoords = getGhostRouteCoords();
  const ghostFull = ghostCoords.length > 1 ? {type:'FeatureCollection',features:[{type:'Feature',geometry:{type:'LineString',coordinates:ghostCoords},properties:{}}]} : emptyFC();
  // Cache DOM reads — this runs on every animation frame
  const showTrail = $('showTrail')?.checked;
  const animDot = $('animDot')?.checked;
  const followCamera = $('followCamera')?.checked;
  const cameraPitch = parseFloat($('cameraPitch')?.value || '45');
  if(showTrail){ state.map.getSource('route-ghost')?.setData(ghostFull); state.map.getSource('route-anim')?.setData(partial); }
  else { state.map.getSource('route-ghost')?.setData(emptyFC()); state.map.getSource('route-anim')?.setData(full); }
  if(animDot && point) ensureAnimMarker(point, finalAngle(progress)); else removeAnimMarker();
  if(followCamera && point && !cameraDriven){ state.map.jumpTo({center:point, pitch:cameraPitch}); }
  updateReadouts();
}

function playAnimation(){
  if(!state.routeCoords.length && !cameraAnimReady()){ setStatus(t('Nejdřív najdi trasu nebo nastav kameru.')); return; }
  cancelAnimationFrame(state.animFrame);
  const total = animationTotal();
  if(state.animElapsed >= total - 0.001){
    state.animElapsed = 0;
    setAnimProgress(0);
  }
  state.animPlaying = true;
  state.smoothAngle = null;
  const startOffset = state.animElapsed;
  const startTs = performance.now() - startOffset*1000;
  const delay = parseFloat($('animStart')?.value || '0');
  const dur = Math.max(0.001, parseFloat($('animDuration')?.value || '8'));
  function tick(ts){
    if(!state.animPlaying) return;
    const elapsed = (ts - startTs)/1000;
    state.animElapsed = Math.min(total, elapsed);
    const p = elapsed <= delay ? 0 : Math.min(1, (elapsed - delay) / dur);
    setAnimProgress(p);
    if(elapsed < total) state.animFrame = requestAnimationFrame(tick);
    else { state.animPlaying = false; setStatus(t('Animace dokončena.')); }
  }
  state.animFrame = requestAnimationFrame(tick);
  setStatus(t('Přehrávám animaci…'));
}
function pauseAnimation(){ state.animPlaying = false; cancelAnimationFrame(state.animFrame); setStatus(t('Animace pozastavena.')); }
function stopAnimation(){ state.animPlaying = false; cancelAnimationFrame(state.animFrame); state.animElapsed = 0; redrawRoute(); removeAnimMarker(); applyCameraAnimProgress(0); updateReadouts(); setStatus(t('Animace zastavena.')); }

