}
function renderCameraKeyframeList(){
  const list = $('cameraKeyframeList'); if(!list) return;
  const kfs = state.cameraAnim.keyframes || [];
  list.innerHTML = '';
  if(!kfs.length){
    const empty = document.createElement('div');
