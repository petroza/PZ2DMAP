function onMapClick(e){
  if(state.draggingViaPoint) return;
  if(state.addingSceneIcon){ addSceneIcon(e.lngLat); return; }
  if(state.addingMapLabel){ addMapLabelAt(e.lngLat); return; }
  if(state.addingFlightPoint){ addManualViaPoint([e.lngLat.lng, e.lngLat.lat], `${e.lngLat.lat.toFixed(5)}, ${e.lngLat.lng.toFixed(5)}`); return; }
  if(handleCzRegionPaintClick(e)) return;
  if(handlePoliticalCountryPaintClick(e)) return;
  clearRoutePointSelection();
  clearSceneIconSelection();
  clearMapLabelSelection();
  const lngLat = [e.lngLat.lng, e.lngLat.lat];
  const label = `${e.lngLat.lat.toFixed(5)}, ${e.lngLat.lng.toFixed(5)}`;
  const ctrlPressed = !!(e.originalEvent && e.originalEvent.ctrlKey);

  if(!isRouteTabActive()) return;

  if(ctrlPressed && state.pointA && state.pointB){
    addManualViaPoint(lngLat, label);
    return; // findRoute called inside addManualViaPoint
  }

  if(!state.pointA || (!state.pointB && state.clickPhase === 'B')){
    if(!state.pointA){
      state.addingFlightPoint = false;
      state.pointA = lngLat;
      if(state.markerA) state.markerA.remove();
      state.markerA = createRoutePointMarker('A', state.pointA);
      $('startInput').value = label;
      fillInputWithReverseGeocode('startInput', lngLat);
      state.clickPhase = 'B';
      setStatus(t('Bod A nastaven. Klikni do mapy pro bod B.'));
      return;
    }

    state.addingFlightPoint = false;
    state.pointB = lngLat;
    if(state.markerB) state.markerB.remove();
    state.markerB = createRoutePointMarker('B', state.pointB);
    $('endInput').value = label;
    fillInputWithReverseGeocode('endInput', lngLat);
    state.clickPhase = 'done';
    setStatus(t('Bod B nastaven.'));
    return;
  }
}

function makeViaMarker(idx){
  return makeDotMarker(String(idx+1),'dot-wp');
}

function updateManualViaPoint(idx, lngLat){
  if(!state.manualViaPoints[idx]) return;
  state.manualViaPoints[idx].lngLat = lngLat;
  state.manualViaPoints[idx].name = `${lngLat[1].toFixed(5)}, ${lngLat[0].toFixed(5)}`;
  renderWaypointList();
  refreshManualViaMarkers();
  if(state.pointA && state.pointB) findRoute();
  else redrawRoute();
}

function removeManualViaPoint(idx, reason='remove'){
  if(idx < 0 || idx >= state.manualViaPoints.length) return;
  state.manualViaPoints.splice(idx,1);
  renderWaypointList();
  refreshManualViaMarkers();
  if(state.pointA && state.pointB) findRoute();
  else redrawRoute();
  if(reason === 'undo') setStatus(t('Vrácen poslední krok vlastní trasy.'));
  else if(reason === 'ctrl-marker') setStatus(t('Bod trasy smazán.'));
}

function refreshManualViaMarkers(){
  state.manualViaMarkers.forEach(m=>m.remove());
  state.manualViaMarkers = state.manualViaPoints.map((pt, idx)=> {
    const el = makeViaMarker(idx);
    el.title = 'Ctrl + klik smaže bod';
    el.addEventListener('click', ev => {
      ev.stopPropagation();
      if(ev.ctrlKey || ev.metaKey){
        ev.preventDefault();
        removeManualViaPoint(idx, 'ctrl-marker');
      }
    });
    const marker = new maplibregl.Marker({element: el, draggable:true})
      .setLngLat(pt.lngLat)
      .addTo(state.map);
    marker.on('dragstart', ()=>{
      state.draggingViaPoint = true;
      setStatus(t('Táhneš bod trasy. Pusť ho na nové místo.'));
    });
    marker.on('dragend', ()=>{
      const ll = marker.getLngLat();
      state.draggingViaPoint = false;
      updateManualViaPoint(idx, [ll.lng, ll.lat]);
      setStatus(t('Bod trasy přesunut.'));
    });
    return marker;
  });
}

function renderWaypointList(){
  const list = $('waypointList');
  const flightList = $('flightWaypointList');
  function buildItems(container){
    if(!container) return;
    container.innerHTML = '';
    if(!state.manualViaPoints.length){
      container.innerHTML = '<div class="small">Zatím žádné body. Ctrl + klik přidává bod. Ctrl + klik na existující bod ho smaže. Backspace vrátí poslední krok.</div>';
      return;
    }
    state.manualViaPoints.forEach((pt, idx) => {
      const wrap = document.createElement('div');
      wrap.className = 'wp-item';
      wrap.innerHTML = `<div class="wp-head"><span class="wp-badge">${idx+1}</span><div class="wp-actions"><button type="button" class="btn btn-sm btn-danger" data-remove="${idx}">Smazat</button></div></div><div class="small">${pt.name}</div>`;
      wrap.querySelector('[data-remove]').addEventListener('click', ()=>{
        removeManualViaPoint(idx);
      });
      container.appendChild(wrap);
    });
  }
  buildItems(list);
  buildItems(flightList);
}

function addManualViaPoint(lngLat, label){
  state.manualViaPoints.push({lngLat, name: label});
  renderWaypointList();
  refreshManualViaMarkers();
  if(state.addingFlightPoint){
    if(state.pointA && state.pointB) findRoute();
    setStatus(t('Bod letu přidán.', state.manualViaPoints.length));
  } else {
    setStatus(t('Přidán průjezdný bod.', state.manualViaPoints.length));
    if(state.pointA && state.pointB) findRoute();
  }
}

function clearManualViaPoints(){
  state.manualViaPoints = [];
  state.addingFlightPoint = false;
  renderWaypointList();
  refreshManualViaMarkers();
}


