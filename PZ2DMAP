function animationTotal(){ return parseFloat($('animStart')?.value || '0') + parseFloat($('animDuration')?.value || '8'); }
function lineLength(coords){ let t=0; for(let i=1;i<coords.length;i++){ const dx=coords[i][0]-coords[i-1][0], dy=coords[i][1]-coords[i-1][1]; t+=Math.hypot(dx,dy);} return t; }
function sliceLineByProgress(coords,progress){
  if(!coords||coords.length<2) return {coords:[], point:null};
  if(progress<=0) return {coords:[coords[0]], point:coords[0]};
  if(progress>=1) return {coords:coords.slice(), point:coords[coords.length-1]};
  const total=lineLength(coords), target=total*progress; let acc=0; const out=[coords[0]];
  for(let i=1;i<coords.length;i++){
    const a=coords[i-1], b=coords[i], dx=b[0]-a[0], dy=b[1]-a[1], seg=Math.hypot(dx,dy);
    if(acc + seg < target){ out.push(b); acc += seg; continue; }
    const t = seg === 0 ? 0 : (target - acc) / seg;
    const p = [a[0] + dx*t, a[1] + dy*t]; out.push(p); return {coords:out, point:p};
  }
  return {coords:coords.slice(), point:coords[coords.length-1]};
}
function routeAngle(coords,progress){
  if(!coords || coords.length < 2) return state.smoothAngle ?? 0;
  const look = 0.012;
  const fromProgress = Math.max(0, progress - look);
  const toProgress = Math.min(1, progress + look);
  const p1 = sliceLineByProgress(coords, fromProgress).point;
  const p2 = sliceLineByProgress(coords, toProgress).point;
  if(!p1 || !p2) return state.smoothAngle ?? 0;
  const dx = p2[0] - p1[0];
  const dy = p2[1] - p1[1];
  if(Math.abs(dx) < 1e-9 && Math.abs(dy) < 1e-9) return state.smoothAngle ?? 0;
  return Math.atan2(dx, dy) * 180 / Math.PI;
}
function smoothAngle(target, factor=0.22){
  if(state.smoothAngle === null){ state.smoothAngle = target; return target; }
  let d = target - state.smoothAngle;
  while(d > 180) d -= 360;
  while(d < -180) d += 360;
  state.smoothAngle += d * factor;
  return state.smoothAngle;
}
function getFixedAngle(type){ return {car:0, bike:0, plane:0, dot:0, sysCar:0, sysPlane:0}[type] ?? 0; }
function getPathFollowBaseAngle(type){ return {car:45, bike:0, plane:-45, dot:0, sysCar:0, sysPlane:0}[type] ?? 0; }
function getFollowOffset(type){ return {car:0, bike:0, plane:0, dot:0, sysCar:0, sysPlane:0}[type] ?? 0; }
function finalAngle(progress){
  const moverType = getCurrentAnimationIconType();
  const manual = getManualAnimAngle();
  if(state.currentRotMode !== 'smooth') return getFixedAngle(moverType) + manual;
  const bearing = routeAngle(state.routeCoords, progress) + getFollowOffset(moverType);
  return getPathFollowBaseAngle(moverType) + smoothAngle(bearing) + manual;
}

