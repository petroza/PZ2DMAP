async function fetchEntityFromServer(entity){
  const res = await fetch(SERVER_API_URL + '?entity=' + encodeURIComponent(entity), {cache:'no-store'});
  if(!res.ok) throw new Error('Server entity fetch failed');
  const data = await res.json();
  if(!data || data.ok === false || !Array.isArray(data.items)) throw new Error('Invalid server payload');
  state.serverApiAvailable = true;
  return data.items;
}
async function pushEntityToServer(entity, items){
  const res = await fetch(SERVER_API_URL, {
    method:'POST',
    headers:{'Content-Type':'application/json', ...(SERVER_API_TOKEN ? {'X-Api-Token': SERVER_API_TOKEN} : {})},
    body: JSON.stringify({entity, action:'replace', items})
  });
  if(!res.ok) throw new Error('Server entity save failed');
  const data = await res.json().catch(()=>({ok:true}));
  if(data && data.ok === false) throw new Error(data.error || 'Server entity save failed');
  state.serverApiAvailable = true;
  return data;
}
// Debounced server sync: localStorage is written immediately (synchronously) by the
// callers, so no data is lost locally. We only coalesce the network POSTs so rapid
// edits don't fire dozens of full-DB "replace" requests (and race each other).
const _syncTimers = {};
const _syncPending = {};
function scheduleEntityPush(entity, items, delay=500){
  _syncPending[entity] = items;
  if(_syncTimers[entity]) clearTimeout(_syncTimers[entity]);
  _syncTimers[entity] = setTimeout(() => {
    _syncTimers[entity] = null;
    const data = _syncPending[entity];
    _syncPending[entity] = null;
    if(data) pushEntityToServer(entity, data).catch(err => console.warn(entity + ' sync failed', err));
  }, delay);
}
function flushEntityPushes(){
  Object.keys(_syncTimers).forEach(entity => {
    if(!_syncTimers[entity]) return;
    clearTimeout(_syncTimers[entity]);
    _syncTimers[entity] = null;
    const data = _syncPending[entity];
    _syncPending[entity] = null;
    if(!data) return;
    try{
      // keepalive lets the request complete even while the page is unloading.
      fetch(SERVER_API_URL, {
        method:'POST',
        headers:{'Content-Type':'application/json', ...(SERVER_API_TOKEN ? {'X-Api-Token': SERVER_API_TOKEN} : {})},
        body: JSON.stringify({entity, action:'replace', items:data}),
        keepalive:true
      }).catch(()=>{});
    }catch(e){}
  });
}
window.addEventListener('beforeunload', flushEntityPushes);
