  if(bounds) state.map.fitBounds(bounds, {padding:getFitPadding(), duration:800});
}

function zoomToCzechia(){
  if(!state.czRegionsGeojson?.features?.length) return;
  const bounds = state.czRegionsGeojson.features.reduce((acc, feature) => {
    const b = getFeatureBounds(feature);
    if(!b) return acc;
    if(!acc) return b;
    acc.extend(b.getSouthWest());
    acc.extend(b.getNorthEast());
    return acc;
  }, null);
  if(bounds) state.map.fitBounds(bounds, {padding:getFitPadding(), duration:800});
}

